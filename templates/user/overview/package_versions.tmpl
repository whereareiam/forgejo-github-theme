{{template "base/head" .}}
{{if .ContextUser.IsOrganization}}
	<div role="main" aria-label="{{.Title}}" class="page-content organization packages">
		{{template "org/header" .}}
		<div class="ui container">
			{{template "package/shared/versionlist" .}}
		</div>
	</div>
{{else}}
	{{template "user/profile_layout_start" .}}
	{{template "user/profile_package_versions" .}}
	{{template "user/profile_layout_end" .}}
{{end}}
{{template "base/footer" .}}
