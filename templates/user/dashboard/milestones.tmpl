{{template "base/head" .}}
{{/* The dashboard's milestones: the issue list's sidebar beside the milestone list a repository shows. */}}
<div role="main" aria-label="{{.Title}}" class="page-content dashboard milestones theme-sidebar-layout" data-theme-sidebar="dashboard_milestone_sidebar_collapsed">
	<aside class="theme-sidebar" aria-label="{{.Title}}">
		<div class="theme-sidebar-content">
			{{template "components/dashboard/context/context" dict "Data" . "Page" "milestones"}}
			<nav aria-label="{{ctx.Locale.Tr "home.issues.in_your_repos"}}">
				{{/* Forgejo fills RepoIDs with every listed repository when nothing is filtered. */}}
				{{$unfiltered := eq (len .RepoIDs) (len .Repos)}}
				<a class="{{if $unfiltered}}active{{end}}" href="?sort={{$.SortType}}&state={{$.State}}&q={{$.Keyword}}">{{svg "octicon-milestone" 16}}<span>{{ctx.Locale.Tr "home.issues.in_your_repos"}}</span><span class="theme-counter">{{.Total}}</span></a>
					{{range .Repos}}
						{{with $Repo := .}}
							{{/* Single-select, as on GitHub: a repository shows only itself, and the selected one goes back to all. */}}
							{{$active := false}}
							{{if not $unfiltered}}{{range $.RepoIDs}}{{if eq . $Repo.ID}}{{$active = true}}{{end}}{{end}}{{end}}
							<a class="{{if $active}}active{{end}}" href="?{{if not $active}}repos=[{{$Repo.ID}}%2C]&{{end}}sort={{$.SortType}}&state={{$.State}}&q={{$.Keyword}}" title="{{.FullName}}">
								{{svg "octicon-repo" 16}}<span class="gt-ellipsis">{{$Repo.FullName}}</span><span class="theme-counter">{{index $.Counts $Repo.ID}}</span>
							</a>
						{{end}}
					{{end}}
			</nav>
			<hr>
			{{template "components/dashboard/context/pages" dict "Data" . "Current" "milestones"}}
		</div>
		{{template "components/common/sidebar/toggle" .}}
	</aside>
	<div class="ui container theme-sidebar-main">
		{{template "base/alert" .}}
		<section class="theme-box-list-page">
		<div class="theme-list-heading">
			<div class="theme-list-title">
				<button type="button" class="theme-icon-button" data-theme-sidebar-toggle data-theme-sidebar-expand aria-expanded="false" aria-label="Expand sidebar">{{svg "octicon-sidebar-expand" 16}}</button>
				<h1>{{ctx.Locale.Tr "repo.milestones"}}</h1>
			</div>
		</div>
		{{$repos := ""}}{{range $.RepoIDs}}{{$repos = print $repos . "%2C"}}{{end}}
		<div class="theme-box-list-toolbar">
			<form class="ui form ignore-dirty theme-box-list-search" role="search">
				<input type="hidden" name="repos" value="[{{range $.RepoIDs}}{{.}},{{end}}]">
				<input type="hidden" name="sort" value="{{$.SortType}}">
				<input type="hidden" name="state" value="{{$.State}}">
				{{template "components/common/search/search" dict "Kind" "icon" "Value" .Keyword "Placeholder" (ctx.Locale.Tr "search.milestone_kind") "Label" (ctx.Locale.Tr "search.milestone_kind")}}
			</form>
		</div>
		{{template "components/repository/milestone/list" dict "Data" . "Query" (print "?repos=[" $repos "]&q=" (QueryEscape .Keyword)) "OpenCount" .MilestoneStats.OpenCount "ClosedCount" .MilestoneStats.ClosedCount "ShowRepo" true}}
		</section>
	</div>
</div>
{{template "base/footer" .}}
