{{/* GitHub's home: a sidebar with the dashboard context, the dashboard pages and the top repositories, beside a
greeting over the activity feed and the work rail (review requests, assigned issues, milestones due and releases). The
contribution graph stays on the profile, as on GitHub. Organization dashboards share the layout with the
organization's pages in the sidebar. */}}
{{template "base/head" .}}
{{$user := .ContextUser}}
{{$isOrg := $user.IsOrganization}}
<div role="main" aria-label="{{.Title}}" class="page-content dashboard feeds theme-sidebar-layout github-home" data-theme-sidebar="dashboard_sidebar_collapsed">
	<aside class="theme-sidebar" aria-label="{{ctx.Locale.Tr "dashboard"}}">
		<div class="theme-sidebar-content">
			{{template "components/dashboard/context/context" dict "Data" . "Page" ""}}
			{{template "components/dashboard/context/pages" dict "Data" . "Current" "home"}}
			<hr>
			<section class="github-home-repositories" aria-labelledby="github-home-repositories-title">
				<div class="github-home-repositories-heading">
					<h2 id="github-home-repositories-title">{{ctx.Locale.Tr "home.my_repos"}}</h2>
					<button type="button" class="theme-icon-button" data-theme-repo-picker-toggle aria-controls="github-home-repositories" aria-label="{{ctx.Locale.Tr "search.repo_kind"}}" data-tooltip-content="{{ctx.Locale.Tr "search.repo_kind"}}">{{svg "octicon-search" 16}}</button>
				</div>
				{{$teamID := 0}}{{if .Team}}{{$teamID = .Team.ID}}{{end}}
				{{template "components/repository/picker/picker" dict "ID" "github-home-repositories" "UID" $user.ID "Team" $teamID "FullName" true "Limit" 10 "More" true "Label" (ctx.Locale.Tr "home.my_repos")}}
			</section>
		</div>
		{{template "components/common/sidebar/toggle" .}}
	</aside>
	<div class="ui container theme-sidebar-main github-home-main">
		{{template "base/alert" .}}
		<div class="theme-list-heading">
			<div class="theme-list-title">
				<button type="button" class="theme-icon-button" data-theme-sidebar-toggle data-theme-sidebar-expand aria-expanded="false" aria-label="{{ctx.Locale.Tr "toggle_menu"}}">{{svg "octicon-sidebar-expand" 16}}</button>
				{{/* GitHub greets the visitor by time of day; Forgejo has no strings for a greeting, so Home is headed by the
				account name. */}}
				<h1>{{$user.DisplayName}}</h1>
			</div>
		</div>
		<div class="github-home-columns">
			<section class="github-home-feed" aria-labelledby="github-home-feed-title">
				{{if .Feeds}}
					<div class="theme-box-list">
						<div class="theme-box-list-header">
							<h2 id="github-home-feed-title" class="github-home-section-title">{{ctx.Locale.Tr "activities"}}</h2>
						</div>
						{{template "components/dashboard/feed/feed" .}}
					</div>
				{{else}}
					<h2 id="github-home-feed-title" class="github-home-section-title">{{ctx.Locale.Tr "activities"}}</h2>
					{{template "user/dashboard/guide" .}}
				{{end}}
			</section>
			{{template "components/dashboard/work/work" .}}
		</div>
	</div>
</div>
{{template "base/footer" .}}
