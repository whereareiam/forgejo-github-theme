<div class="profile-repositories flex-list">
	{{range .Repos}}
		<div class="flex-item">
			<div class="flex-item-main">
				<div class="flex-item-header">
					<div class="flex-item-title">
						{{if and (or $.PageIsExplore $.PageIsProfileStarList (eq $.TabName "watching")) .Owner}}
						<a class="text primary name profile-repo-owner" href="{{.Owner.HomeLink}}">{{.Owner.Name}}</a><span class="profile-repo-separator">/</span>
						{{end}}
						<a class="text primary name" href="{{.Link}}">{{.Name}}</a>
						<span>
							{{if .IsArchived}}
								<span class="ui label">{{ctx.Locale.Tr "repo.desc.archived"}}</span>
							{{end}}
							{{if .IsPrivate}}
								<span class="ui label">{{ctx.Locale.Tr "repo.desc.private"}}</span>
							{{else}}
								{{if .Owner.Visibility.IsPrivate}}
									<span class="ui label">{{ctx.Locale.Tr "repo.desc.internal"}}</span>
								{{else}}
									<span class="ui label">{{ctx.Locale.Tr "settings.visibility.public"}}</span>
								{{end}}
							{{end}}
							{{if .IsTemplate}}
								<span class="ui label">{{ctx.Locale.Tr "repo.desc.template"}}</span>
							{{end}}
							{{if eq .ObjectFormatName "sha256"}}
								<span class="ui label">{{ctx.Locale.Tr "repo.desc.sha256"}}</span>
							{{end}}
						</span>
					</div>
				</div>
				{{$description := .DescriptionHTML $.Context}}
				{{if $description}}
					<div class="flex-item-body">{{$description}}</div>
				{{end}}
				{{if .Topics}}
					<div class="repo-topics">
					{{range .Topics}}
						{{if ne . ""}}<a class="ui label" href="{{AppSubUrl}}/explore/repos?q={{.}}&topic=1">{{.}}</a>{{end}}
					{{end}}
					</div>
				{{end}}
				<div class="flex-item-trailing muted-links">
					{{if or .IsMirror .IsFork}}
						<span class="profile-repo-kind">{{template "repo/icon" .}}</span>
					{{end}}
					{{if .PrimaryLanguage}}
						<a class="flex-text-inline" href="?q={{$.Keyword}}&sort={{$.SortType}}&language={{.PrimaryLanguage.Language}}{{if $.TabName}}&tab={{$.TabName}}{{end}}">
							<i class="color-icon tw-mr-2" style="background-color: {{.PrimaryLanguage.Color}}"></i>
							{{.PrimaryLanguage.Language}}
						</a>
					{{end}}
					{{if not $.DisableStars}}
						<a class="flex-text-inline" href="{{.Link}}/stars"
							aria-label="{{ctx.Locale.TrPluralString .NumStars "stars.n_stars" (printf "%d" .NumStars)}}"
							{{if ge .NumStars 1000}}
								data-tooltip-content="{{ctx.Locale.TrPluralString .NumStars "stars.n_stars" (ctx.Locale.PrettyNumber .NumStars)}}"
							{{end}}
							>
							{{svg "octicon-star" 16}}
							{{CountFmt .NumStars}}
						</a>
					{{end}}
					{{if not $.DisableForks}}
						<a class="flex-text-inline" href="{{.Link}}/forks"
							aria-label="{{ctx.Locale.TrPluralString .NumForks "fork.n_forks" (printf "%d" .NumForks)}}"
							{{if ge .NumForks 1000}}
								data-tooltip-content="{{ctx.Locale.TrPluralString .NumForks "fork.n_forks" (ctx.Locale.PrettyNumber .NumForks)}}"
							{{end}}
							>
							{{svg "octicon-repo-forked" 16}}
							{{CountFmt .NumForks}}
						</a>
					{{end}}
					<span class="profile-repo-updated">{{ctx.Locale.Tr "org.repo_updated" (DateUtils.TimeSince .UpdatedUnix)}}</span>
				</div>
			</div>
		</div>
	{{else}}
	{{$emptyIcon := "octicon-repo"}}
	{{if .PageIsProfileStarList}}{{$emptyIcon = "octicon-star"}}{{else if eq .TabName "watching"}}{{$emptyIcon = "octicon-eye"}}{{end}}
	{{template "user/profile_empty" dict "Icon" $emptyIcon "Title" (ctx.Locale.Tr "search.no_results")}}
	{{end}}
</div>
