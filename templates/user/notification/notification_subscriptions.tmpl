{{/* Subscriptions and watched repositories in the notifications sidebar layout, as the inbox: the heading, then the
subscribed issues in a box headed by All, Open and Closed with Type and Sort, or the watched repositories. */}}
{{template "base/head" .}}
{{$current := "subscriptions"}}{{if eq .Status 2}}{{$current = "watching"}}{{end}}
<div role="main" aria-label="{{.Title}}" class="page-content user notification theme-sidebar-layout github-notifications github-subscriptions" data-theme-sidebar="notification_sidebar_collapsed">
	{{template "user/notification/sidebar" dict "Data" . "Current" $current}}
	<div class="ui container theme-sidebar-main">
		<div class="theme-list-heading">
			<div class="theme-list-title">
				<button type="button" class="theme-icon-button" data-theme-sidebar-toggle data-theme-sidebar-expand aria-expanded="false" aria-label="{{ctx.Locale.Tr "toggle_menu"}}">{{svg "octicon-sidebar-expand" 16}}</button>
				<h1>{{if eq .Status 1}}{{ctx.Locale.Tr "notification.subscriptions"}}{{else}}{{ctx.Locale.Tr "notification.watching"}}{{end}}</h1>
			</div>
		</div>
		{{if eq .Status 1}}
			<div class="theme-box-list">
				<div class="theme-box-list-header">
					<nav class="theme-box-list-states" aria-label="{{ctx.Locale.Tr "notification.subscriptions"}}">
						<a href="?sort={{$.SortType}}&state=all&issueType={{$.IssueType}}&labels={{$.Labels}}"{{if eq .State "all"}} aria-current="page"{{end}}>{{ctx.Locale.Tr "all"}}</a>
						<a href="?sort={{$.SortType}}&state=open&issueType={{$.IssueType}}&labels={{$.Labels}}"{{if eq .State "open"}} aria-current="page"{{end}}>{{ctx.Locale.Tr "repo.issues.open_title"}}</a>
						<a href="?sort={{$.SortType}}&state=closed&issueType={{$.IssueType}}&labels={{$.Labels}}"{{if eq .State "closed"}} aria-current="page"{{end}}>{{ctx.Locale.Tr "repo.issues.closed_title"}}</a>
					</nav>
					<div class="theme-box-list-filters">
						{{template "components/common/dropdown/dropdown" dict "Kind" "actions" "Label" (ctx.Locale.Tr "repo.issues.filter_type") "Quiet" true "Items" "user/notification/subscriptions_type" "Data" .}}
						{{template "components/common/dropdown/dropdown" dict "Kind" "actions" "Label" (ctx.Locale.Tr "repo.issues.filter_sort") "Quiet" true "Items" "user/notification/subscriptions_sort" "Data" .}}
					</div>
				</div>
				{{if .Issues}}
					{{template "shared/issuelist" dict "." . "listType" "dashboard"}}
				{{else}}
					<div class="theme-empty theme-empty-compact">
						{{svg "octicon-bell" 24}}
						<h3>{{ctx.Locale.Tr "notification.no_subscriptions"}}</h3>
					</div>
				{{end}}
			</div>
		{{else}}
			{{template "shared/repo_search" .}}
			{{template "explore/repo_list" .}}
			{{template "base/paginate" .}}
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
