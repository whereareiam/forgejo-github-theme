{{/* GitHub's two-factor authentication section: before enrolment a spacious blankslate with the button that starts it;
	once enrolled an Enabled label beside the title and a box of what can be done, one row each for the authenticator
	app, the recovery key and disabling it. */}}
<h4 class="ui top attached header">
	<span class="theme-settings-title-with-label">
		{{ctx.Locale.Tr "twofa"}}
		{{if .TOTPEnrolled}}<span class="ui green label theme-label">{{ctx.Locale.Tr "enabled"}}</span>{{end}}
	</span>
</h4>
<div class="ui attached segment">
	{{if .TOTPEnrolled}}
	<p class="theme-settings-description">{{ctx.Locale.Tr "settings.twofa_desc"}}</p>
	<ul class="theme-settings-box">
		<li class="theme-settings-box-row">
			<span class="theme-settings-box-icon">{{svg "octicon-device-mobile"}}</span>
			<div class="theme-settings-box-main">
				<span class="theme-settings-box-title">{{ctx.Locale.Tr "settings.twofa"}}</span>
				<p class="theme-settings-box-meta">{{ctx.Locale.Tr "settings.twofa_is_enrolled"}}</p>
			</div>
			<div class="theme-settings-box-actions">
				<a class="ui tiny button" href="{{AppSubUrl}}/user/settings/security/two_factor/reenroll">{{ctx.Locale.Tr "settings.twofa_reenroll"}}</a>
			</div>
		</li>
		<li class="theme-settings-box-row">
			<span class="theme-settings-box-icon">{{svg "octicon-key"}}</span>
			<div class="theme-settings-box-main">
				<span class="theme-settings-box-title">{{ctx.Locale.Tr "twofa_scratch"}}</span>
				<p class="theme-settings-box-meta">{{ctx.Locale.Tr "settings.twofa_recovery_tip"}} {{ctx.Locale.Tr "settings.regenerate_scratch_token_desc"}}</p>
			</div>
			<form class="theme-settings-box-actions" action="{{AppSubUrl}}/user/settings/security/two_factor/regenerate_scratch" method="post" enctype="multipart/form-data">
				<button class="ui tiny button">{{ctx.Locale.Tr "settings.twofa_scratch_token_regenerate"}}</button>
			</form>
		</li>
		<li class="theme-settings-box-row theme-settings-box-row-danger">
			<span class="theme-settings-box-icon">{{svg "octicon-shield-x"}}</span>
			<div class="theme-settings-box-main">
				<span class="theme-settings-box-title">{{ctx.Locale.Tr "settings.twofa_disable"}}</span>
				{{if .SignedUser.MustHaveTwoFactor}}
					<p class="theme-settings-box-meta">{{ctx.Locale.Tr "settings.twofa_unroll_unavailable"}}</p>
				{{else}}
					<p class="theme-settings-box-meta">{{ctx.Locale.Tr "settings.twofa_disable_note"}}</p>
				{{end}}
			</div>
			{{if not .SignedUser.MustHaveTwoFactor}}
			<form class="theme-settings-box-actions" action="{{AppSubUrl}}/user/settings/security/two_factor/disable" method="post" enctype="multipart/form-data" id="disable-form">
				<button class="ui red tiny button delete-button" data-modal-id="disable-twofa" data-type="form" data-form="#disable-form">{{ctx.Locale.Tr "settings.twofa_disable"}}</button>
			</form>
			{{end}}
		</li>
	</ul>
	{{else}}
	{{/* The recovery tip is there as a means of encouraging a user to enroll */}}
	{{template "components/common/settings/blankslate" dict
		"Icon" "octicon-shield-lock"
		"Title" (ctx.Locale.Tr "settings.twofa_not_enrolled")
		"Description" (HTMLFormat "%s %s" (ctx.Locale.Tr "settings.twofa_desc") (ctx.Locale.Tr "settings.twofa_recovery_tip"))
		"Action" (HTMLFormat `<a class="ui primary button" href="%s/user/settings/security/two_factor/enroll">%s</a>` AppSubUrl (ctx.Locale.Tr "settings.twofa_enroll"))}}
	{{end}}

	<div class="ui g-modal-confirm delete modal" id="disable-twofa">
		<div class="header">
			{{svg "octicon-trash"}}
			{{ctx.Locale.Tr "settings.twofa_disable"}}
		</div>
		<div class="content">
			<p>{{ctx.Locale.Tr "settings.twofa_disable_desc"}}</p>
		</div>
		{{template "base/modal_actions_confirm" .}}
	</div>
</div>
