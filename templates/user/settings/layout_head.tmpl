{{template "base/head" .ctxData}}
<div role="main" aria-label="{{.ctxData.Title}}" class="page-content {{.pageClass}}">
	{{if not .ctxData.HideNavbarLinks}}
	<div class="ui container theme-settings-context-container">
		{{template "components/common/settings/context" dict "Avatar" (ctx.AvatarUtils.Avatar .ctxData.SignedUser 48) "Title" (.ctxData.SignedUser.DisplayName) "Login" .ctxData.SignedUser.Name "Subtitle" (ctx.Locale.Tr "concept_user_individual") "Link" .ctxData.SignedUser.HomeLink "LinkIcon" "octicon-person" "LinkLabel" (ctx.Locale.Tr "your_profile")}}
	</div>
	{{end}}
	<div class="ui container flex-container theme-settings">
		{{template "user/settings/navbar" .ctxData}}
		<div class="flex-container-main">
			{{template "base/alert" .ctxData}}
			{{/* block: user-setting-content */}}

{{if false}}{{/* to make html structure "likely" complete to prevent IDE warnings */}}
		</div>
	</div>
</div>
{{end}}
