{{/* GitHub's personal settings nav: an icon per page in groups. Forgejo has strings only for Integrations, so the
	other groups are set apart by a separator instead of an English name. */}}
{{if not .HideNavbarLinks}}
<div class="flex-container-nav">
	<div class="ui fluid vertical menu theme-nav-list">
		<a class="{{if .PageIsSettingsProfile}}active {{end}}item" href="{{AppSubUrl}}/user/settings">
			{{svg "octicon-person" 16}}{{ctx.Locale.Tr "settings.profile"}}
		</a>
		<a class="{{if .PageIsSettingsAccount}}active {{end}}item" href="{{AppSubUrl}}/user/settings/account">
			{{svg "octicon-gear" 16}}{{ctx.Locale.Tr "settings.account"}}
		</a>
		<a class="{{if .PageIsSettingsAppearance}}active {{end}}item" href="{{AppSubUrl}}/user/settings/appearance">
			{{svg "octicon-paintbrush" 16}}{{ctx.Locale.Tr "settings.appearance"}}
		</a>
		<div class="theme-settings-separator" role="separator"></div>
		<a class="{{if .PageIsSettingsSecurity}}active {{end}}item" href="{{AppSubUrl}}/user/settings/security">
			{{svg "octicon-shield-lock" 16}}{{ctx.Locale.Tr "settings.security"}}
		</a>
		<a class="{{if .PageIsSettingsKeys}}active {{end}}item" href="{{AppSubUrl}}/user/settings/keys">
			{{svg "octicon-key" 16}}{{ctx.Locale.Tr "settings.ssh_gpg_keys"}}
		</a>
		<a class="{{if .PageIsSettingsOrganization}}active {{end}}item" href="{{AppSubUrl}}/user/settings/organization">
			{{svg "octicon-organization" 16}}{{ctx.Locale.Tr "settings.organization"}}
		</a>
		<a class="{{if .PageIsBlockedUsers}}active {{end}}item" href="{{AppSubUrl}}/user/settings/blocked_users">
			{{svg "octicon-blocked" 16}}{{ctx.Locale.Tr "settings.blocked_users"}}
		</a>
		<div class="theme-settings-separator" role="separator"></div>
		<a class="{{if .PageIsSettingsRepos}}active {{end}}item" href="{{AppSubUrl}}/user/settings/repos">
			{{svg "octicon-repo" 16}}{{ctx.Locale.Tr "settings.repos"}}
		</a>
		{{if .EnablePackages}}
		<a class="{{if .PageIsSettingsPackages}}active {{end}}item" href="{{AppSubUrl}}/user/settings/packages">
			{{svg "octicon-package" 16}}{{ctx.Locale.Tr "packages.title"}}
		</a>
		{{end}}
		{{if .EnableActions}}
		<details class="item toggleable-item" {{if or .PageIsSharedSettingsRunners .PageIsSharedSettingsSecrets .PageIsSharedSettingsVariables}}open{{end}}>
			<summary>{{svg "octicon-play" 16}}{{ctx.Locale.Tr "actions.actions"}}</summary>
			<div class="menu">
				<a class="{{if .PageIsSharedSettingsRunners}}active {{end}}item" href="{{AppSubUrl}}/user/settings/actions/runners">
					{{ctx.Locale.Tr "actions.runners"}}
				</a>
				<a class="{{if .PageIsSharedSettingsSecrets}}active {{end}}item" href="{{AppSubUrl}}/user/settings/actions/secrets">
					{{ctx.Locale.Tr "secrets.secrets"}}
				</a>
				<a class="{{if .PageIsSharedSettingsVariables}}active {{end}}item" href="{{AppSubUrl}}/user/settings/actions/variables">
					{{ctx.Locale.Tr "actions.variables"}}
				</a>
			</div>
		</details>
		{{end}}
		{{if not DisableWebhooks}}
		<a class="{{if .PageIsSettingsHooks}}active {{end}}item" href="{{AppSubUrl}}/user/settings/hooks">
			{{svg "octicon-webhook" 16}}{{ctx.Locale.Tr "repo.settings.hooks"}}
		</a>
		{{end}}
		{{if .EnableQuota}}
			<a class="{{if .PageIsStorageOverview}}active {{end}}item" href="{{AppSubUrl}}/user/settings/storage_overview">
				{{svg "octicon-database" 16}}{{ctx.Locale.Tr "settings.storage_overview"}}
			</a>
		{{end}}
		<div class="theme-settings-group">{{ctx.Locale.Tr "admin.integrations"}}</div>
		<a class="{{if .PageIsSettingsApplications}}active {{end}}item" href="{{AppSubUrl}}/user/settings/applications">
			{{svg "octicon-apps" 16}}{{ctx.Locale.Tr "settings.applications"}}
		</a>
		<a class="{{if .PageIsSettingsAuthorizedIntegrations}}active {{end}}item" href="{{AppSubUrl}}/user/settings/authorized-integrations">
			{{svg "octicon-plug" 16}}{{ctx.Locale.Tr "settings.authorized_integrations"}}
		</a>
	</div>
</div>
{{end}}
