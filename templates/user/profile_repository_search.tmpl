<div class="profile-repo-toolbar">
	<form id="repo-search-form" class="ui form ignore-dirty profile-repo-search" role="search" data-theme-repository-search>
		{{if .Language}}<input type="hidden" name="language" value="{{.Language}}">{{end}}
		{{if .TopicOnly}}<input type="hidden" name="topic" value="{{.TopicOnly}}">{{end}}
		{{if .Org}}<input type="hidden" name="tab" value="overview">{{else if .TabName}}<input type="hidden" name="tab" value="{{.TabName}}">{{end}}
		<input class="profile-repo-query" type="search" name="q" value="{{.Keyword}}" placeholder="{{if .Org}}Find a repository…{{else}}{{ctx.Locale.Tr "search.repo_kind"}}{{end}}" aria-label="{{ctx.Locale.Tr "search.repo_kind"}}" maxlength="255" spellcheck="false" dir="auto">
		{{if .PageIsProfileStarList}}<button type="submit" class="secondary button profile-search-submit">{{ctx.Locale.Tr "search.search"}}</button>{{end}}
		{{template "shared/theme/repo_filter" .}}
		{{template "shared/theme/repo_sort" .}}
	</form>
	{{if and .IsSigned (eq .SignedUserID .ContextUser.ID) (eq .TabName "repositories")}}
		<a class="primary button profile-new-repo" href="{{AppSubUrl}}/repo/create">{{svg "octicon-repo" 16}}{{ctx.Locale.Tr "new_repo.link"}}</a>
	{{end}}
	{{if .Org}}{{template "org/repository_actions" .}}{{end}}
</div>
