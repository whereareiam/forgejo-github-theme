{{/* Shared commit row for repository history and pull-request date groups. */}}
{{$page := .Page}}{{$commit := .Commit}}{{$commitID := $commit.ID.String}}
{{$commitRepoLink := $page.RepoLink}}{{if $page.CommitRepoLink}}{{$commitRepoLink = $page.CommitRepoLink}}{{end}}
{{$shortHash := ""}}{{if $page.PageIsPullCommits}}{{$shortHash = printf "%.7s" $commitID}}{{end}}
			<li class="gitea-github-theme-commit">
				<div class="message">
					{{if $page.PageIsWiki}}
						<span class="commit-summary {{if gt $commit.ParentCount 1}}grey text{{end}}" title="{{$commit.Summary}}">{{$commit.Summary | RenderEmoji $page.Context}}</span>
					{{else}}
						{{$commitLink := printf "%s/commit/%s" $commitRepoLink (PathEscape $commitID)}}
						{{if $page.PageIsPullCommits}}
							{{$commitLink = printf "%s/pulls/%d/commits/%s" $commitRepoLink $page.Issue.Index (PathEscape $commitID)}}
						{{end}}
						<span class="commit-summary {{if gt $commit.ParentCount 1}}grey text{{end}}" title="{{$commit.Summary}}">
							{{template "repo/commit_message_subject" dict
								"Context" $page.Context
								"Message" $commit.Message
								"Summary" $commit.Summary
								"CommitLink" $commitLink
								"Metas" ($page.Repository.ComposeMetas ctx)
							}}
						</span>
					{{end}}
					{{if IsMultilineCommitMessage $commit.Message}}
						<button class="ui button js-toggle-commit-body ellipsis-button" aria-expanded="false">...</button>
						<pre class="commit-body tw-hidden">{{RenderCommitBody $page.Context $commit.Message ($page.Repository.ComposeMetas ctx)}}</pre>
					{{end}}
				</div>
				<div class="metadata">
					{{$userName := $commit.Author.Name}}
					{{if $commit.User}}
						{{if and $commit.User.FullName DefaultShowFullName}}
							{{$userName = $commit.User.FullName}}
						{{end}}
						{{ctx.AvatarUtils.Avatar $commit.User 20}}
						<a class="muted author-wrapper" href="{{$commit.User.HomeLink}}">{{$userName}}</a>
					{{else}}
						{{ctx.AvatarUtils.AvatarByEmail $commit.Author.Email $commit.Author.Name 20}}
						<span class="author-wrapper">{{$userName}}</span>
					{{end}}
					{{if $page.PageIsPullCommits}}<span>committed</span>{{end}}
					{{if $commit.Committer}}
						{{DateUtils.TimeSince $commit.Committer.When}}
					{{else}}
						{{DateUtils.TimeSince $commit.Author.When}}
					{{end}}
					{{template "repo/commit_statuses" dict "Status" $commit.Status "Statuses" $commit.Statuses}}
				</div>
				<div class="extra">
					{{if $page.CommitTagsMap}}
						{{range (index $page.CommitTagsMap $commitID)}}
							{{- template "repo/tag/name" dict "AdditionalClasses" "gitea-github-theme-tag" "RepoLink" $page.Repository.Link "TagName" .TagName "IsRelease" (not .IsTag) -}}
						{{end}}
					{{end}}
					{{$commitBaseLink := ""}}
					{{if $page.PageIsWiki}}
						{{$commitBaseLink = printf "%s/wiki/commit" $commitRepoLink}}
					{{else if $page.PageIsPullCommits}}
						{{$commitBaseLink = printf "%s/pulls/%d/commits" $commitRepoLink $page.Issue.Index}}
					{{else}}
						{{$commitBaseLink = printf "%s/commit" $commitRepoLink}}
					{{end}}
					{{template "repo/commit_sign_badge" dict "Commit" $commit "CommitBaseLink" $commitBaseLink "CommitSignVerification" $commit.Verification "ShortHash" $shortHash}}
				</div>
				<div class="actions">
					<button class="btn interact-bg copy-commit-id gitea-github-theme-action" data-tooltip-content="{{ctx.Locale.Tr "copy_hash"}}" data-clipboard-text="{{$commitID}}">{{svg "octicon-copy"}}</button>
					{{if not $page.PageIsWiki}}
						{{if $page.FileName}}
						<a class="btn interact-bg view-single-diff gitea-github-theme-action" data-tooltip-content="{{ctx.Locale.Tr "repo.commits.view_single_diff"}}"
							href="{{$commitRepoLink}}/commit/{{PathEscape $commitID}}?files={{PathEscapeSegments $page.FileName}}"
						>{{svg "octicon-file-diff"}}</a>
						{{end}}
						<a class="btn interact-bg view-commit-path gitea-github-theme-action" data-tooltip-content="{{ctx.Locale.Tr "repo.commits.view_path"}}"
							href="{{if $page.FileName}}{{printf "%s/src/commit/%s/%s" $commitRepoLink (PathEscape $commitID) (PathEscapeSegments $page.FileName)}}{{else}}{{printf "%s/src/commit/%s" $commitRepoLink (PathEscape $commitID)}}{{end}}"
						>{{if $page.PageIsPullCommits}}{{svg "octicon-code"}}{{else}}{{svg "octicon-file-code"}}{{end}}</a>
					{{end}}
				</div>
			</li>
