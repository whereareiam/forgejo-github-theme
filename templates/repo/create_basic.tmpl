{{/* Without the right to own a repository, the first organization is the owner selected first. */}}
{{$owner := .ContextUser}}
{{if and (not .CanCreateRepo) .Orgs}}{{$owner = index .Orgs 0}}{{end}}
{{template "components/repository/create/owner" dict "Owner" $owner "Personal" (and .CanCreateRepo .SignedUser) "Orgs" .Orgs "Name" .repo_name "ErrOwner" .Err_Owner "ErrName" .Err_RepoName}}
<p class="help theme-create-owner-help">
	{{ctx.Locale.Tr "repo.repo_name_helper"}}
	{{ctx.Locale.Tr "repo.owner_helper"}}
</p>
<div class="field{{if .Err_Description}} error{{end}}">
	<label for="description">{{ctx.Locale.Tr "repo.repo_desc"}}</label>
	<textarea id="description" rows="2" name="description" placeholder="{{ctx.Locale.Tr "repo.repo_desc_helper"}}" maxlength="2048">{{.description}}</textarea>
</div>
<div class="divider"></div>
{{template "components/repository/create/visibility" dict "Private" .private "Forced" .IsForcedPrivate}}
<div class="divider"></div>
