{{/* GitHub-style commit page using Forgejo commit and diff data directly. */}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository diff commit-page">
	<div class="ui container fluid padded commit-page-container">
		<section class="commit-page-header" aria-labelledby="commit-title">
			<div class="commit-title-row">
				<h1 class="commit-title" id="commit-title">{{ctx.Locale.Tr "repo.commit"}} <code>{{printf "%.7s" .CommitID}}</code></h1>
				<div class="commit-page-actions">
					<a class="ui button" href="{{.SourcePath}}" aria-label="{{ctx.Locale.Tr "repo.diff.browse_source"}}">
						{{svg "octicon-file-code" 16}}
						<span>{{ctx.Locale.Tr "repo.diff.browse_source"}}</span>
					</a>
					{{if and ($.Permission.CanWrite $.UnitTypeCode) (not $.Repository.IsArchived) (not .IsDeleted)}}{{- /* */ -}}
						<div class="ui dropdown button commit-operations" data-tooltip-content="{{ctx.Locale.Tr "repo.commit.operations"}}">
							{{svg "octicon-kebab-horizontal" 16}}
							<div class="menu">
								<div class="ui header">{{ctx.Locale.Tr "repo.commit.operations"}}</div>
								<div class="divider"></div>
								<div class="item show-modal" data-modal="#create-branch-modal">
									{{ctx.Locale.Tr "repo.branch.create_branch_operation"}}
								</div>
								<div class="item show-modal" data-modal="#create-tag-modal">
									{{ctx.Locale.Tr "repo.tag.create_tag_operation"}}
								</div>
								<div class="item show-modal revert-button"
									data-modal="#cherry-pick-modal"
									data-modal-cherry-pick-type="revert"
									data-modal-cherry-pick-header="{{ctx.Locale.Tr "repo.commit.revert-header" (ShortSha .CommitID)}}"
									data-modal-cherry-pick-content="{{ctx.Locale.Tr "repo.commit.revert-content"}}"
									data-modal-cherry-pick-submit="{{ctx.Locale.Tr "repo.commit.revert"}}">{{ctx.Locale.Tr "repo.commit.revert"}}</div>
								<div class="item cherry-pick-button show-modal"
									data-modal="#cherry-pick-modal"
									data-modal-cherry-pick-type="cherry-pick"
									data-modal-cherry-pick-header="{{ctx.Locale.Tr "repo.commit.cherry-pick-header" (ShortSha .CommitID)}}"
									data-modal-cherry-pick-content="{{ctx.Locale.Tr "repo.commit.cherry-pick-content"}}"
									data-modal-cherry-pick-submit="{{ctx.Locale.Tr "repo.commit.cherry-pick"}}">{{ctx.Locale.Tr "repo.commit.cherry-pick"}}</div>
								{{if not .NoteRendered}}
									<div id="commit-notes-add-button" class="item">
										{{ctx.Locale.Tr "repo.diff.git-notes.add"}}
									</div>
								{{end}}
							</div>
						</div>
						<dialog id="cherry-pick-modal">
							<article>
								<header><span id="cherry-pick-header"></span></header>
								<div class="content">
									<p id="cherry-pick-content" class="branch-dropdown"></p>
									{{template "repo/branch_dropdown" dict "root" .
										"noTag" true "disableCreateBranch" true
										"branchForm" "branch-dropdown-form"
										"branchURLPrefix" (printf "%s/_cherrypick/%s/" $.RepoLink .CommitID) "branchURLSuffix" ""
										"setAction" true "submitForm" true}}
								</div>
								<form method="get" action="{{$.RepoLink}}/_cherrypick/{{.CommitID}}/{{PathEscapeSegments $.Repository.DefaultBranch}}" id="branch-dropdown-form">
									<input type="hidden" name="ref" value="{{$.Repository.DefaultBranch}}">
									<input type="hidden" name="refType" value="branch">
									<input type="hidden" id="cherry-pick-type" name="cherry-pick-type">
									<div class="actions">
										<button type="button" class="ui cancel button">{{ctx.Locale.Tr "settings.cancel"}}</button>
										<button type="submit" id="cherry-pick-submit" class="ui primary button"></button>
									</div>
								</form>
							</article>
						</dialog>
						<dialog id="create-branch-modal">
							<article>
								<header>{{ctx.Locale.Tr "repo.branch.new_branch"}}</header>
								<form class="ui form" action="{{.RepoLink}}/branches/_new/commit/{{.CommitID}}" method="post">
									<div class="content">
										<div class="field">
											<label><span class="text">{{ctx.Locale.Tr "repo.branch.new_branch_from" (ShortSha .CommitID)}}</span></label>
										</div>
										<div class="required field">
											<label for="new_branch_name">{{ctx.Locale.Tr "repo.branch.name"}}</label>
											<input id="new_branch_name" name="new_branch_name" required>
										</div>
									</div>
									<div class="actions">
										<button type="button" class="ui cancel button">{{ctx.Locale.Tr "settings.cancel"}}</button>
										<button class="ui primary button">{{ctx.Locale.Tr "repo.branch.confirm_create_branch"}}</button>
									</div>
								</form>
							</article>
						</dialog>
						<dialog id="create-tag-modal">
							<article>
								<header>{{ctx.Locale.Tr "repo.tag.create_tag_operation"}}</header>
								<form class="ui form" action="{{.RepoLink}}/branches/_new/commit/{{.CommitID}}" method="post">
									<div class="content">
										<input type="hidden" name="create_tag" value="true">
										<div class="field">
											<label><span class="text">{{ctx.Locale.Tr "repo.tag.create_tag_from" (ShortSha .CommitID)}}</span></label>
										</div>
										<div class="required field">
											<label for="new_tag_name">{{ctx.Locale.Tr "repo.release.tag_name"}}</label>
											<input id="new_tag_name" name="new_branch_name" required>
										</div>
									</div>
									<div class="actions">
										<button type="button" class="ui cancel button">{{ctx.Locale.Tr "settings.cancel"}}</button>
										<button class="ui primary button">{{ctx.Locale.Tr "repo.tag.confirm_create_tag"}}</button>
									</div>
								</form>
							</article>
						</dialog>
					{{end}}
				</div>
			</div>

			<div class="commit-attribution">
				<span class="commit-avatar-stack">
					{{if .Author}}
						{{ctx.AvatarUtils.Avatar .Author 20}}
					{{else}}
						{{ctx.AvatarUtils.AvatarByEmail .Commit.Author.Email .Commit.Author.Name 20}}
					{{end}}
					{{if or (ne .Commit.Committer.Name .Commit.Author.Name) (ne .Commit.Committer.Email .Commit.Author.Email)}}
						{{if ne .Verification.CommittingUser.ID 0}}
							{{ctx.AvatarUtils.Avatar .Verification.CommittingUser 20}}
						{{else}}
							{{ctx.AvatarUtils.AvatarByEmail .Commit.Committer.Email .Commit.Committer.Name 20}}
						{{end}}
					{{end}}
				</span>
				{{if .Author}}
					<a href="{{.Author.HomeLink}}">{{if .Author.FullName}}{{.Author.FullName}}{{else}}{{.Commit.Author.Name}}{{end}}</a>
				{{else}}
					<strong>{{.Commit.Author.Name}}</strong>
				{{end}}
				<span>{{DateUtils.TimeSince .Commit.Author.When}}</span>
				{{if or (ne .Commit.Committer.Name .Commit.Author.Name) (ne .Commit.Committer.Email .Commit.Author.Email)}}
					<span class="commit-attribution-separator">·</span>
					<span>{{ctx.Locale.Tr "repo.diff.committed_by"}}</span>
					{{if ne .Verification.CommittingUser.ID 0}}
						<a href="{{.Verification.CommittingUser.HomeLink}}">{{.Commit.Committer.Name}}</a>
					{{else}}
						<strong>{{.Commit.Committer.Name}}</strong>
					{{end}}
				{{end}}
				{{template "repo/commit_statuses" dict "Status" .CommitStatus "Statuses" .CommitStatuses}}
				{{if and .Commit.Signature .Verification.Verified}}
					<span class="commit-attribution-separator">·</span>
					<span class="commit-verification" data-tooltip-content="{{.Verification.Reason}}">
						{{svg "octicon-verified" 14}}
					</span>
				{{end}}
			</div>

			<div class="commit-card">
				<div class="commit-message">
					<div class="commit-summary">{{RenderCommitMessage $.Context .Commit.Message ($.Repository.ComposeMetas ctx)}}</div>
					{{if IsMultilineCommitMessage .Commit.Message}}
						<pre class="commit-body">{{RenderCommitBody $.Context .Commit.Message ($.Repository.ComposeMetas ctx)}}</pre>
					{{end}}
				</div>
				<div class="commit-meta-row">
					{{template "repo/commit_load_branches_and_tags" .}}
					<div class="commit-identifiers">
                        <a href="{{.Link}}.patch" data-tooltip-content="{{ctx.Locale.Tr "repo.diff.download_patch"}}">patch</a><a href="{{.Link}}.diff" data-tooltip-content="{{ctx.Locale.Tr "repo.diff.download_diff"}}">diff</a><span>·</span>
						{{if .Parents}}
							<span class="commit-identifier">
								<span>{{len .Parents}} {{ctx.Locale.Tr "repo.diff.parent"}}</span>
								{{range $i, $parent := .Parents}}
									{{if $i}}<span>+</span>{{end}}
									{{if $.PageIsWiki}}
										<a href="{{$.RepoLink}}/wiki/commit/{{PathEscape $parent}}">{{printf "%.7s" $parent}}</a>
									{{else}}
										<a href="{{$.RepoLink}}/commit/{{PathEscape $parent}}">{{printf "%.7s" $parent}}</a>
									{{end}}
								{{end}}
							</span>
						{{end}}
						<span class="commit-identifier commit-identifier-current">
							<span>{{ctx.Locale.Tr "repo.diff.commit"}}</span>
							<code>{{printf "%.7s" .CommitID}}</code>
							<button class="btn interact-bg commit-copy" data-clipboard-text="{{.CommitID}}" data-tooltip-content="{{ctx.Locale.Tr "copy_hash"}}" aria-label="{{ctx.Locale.Tr "copy_hash"}}">
								{{svg "octicon-copy" 16}}
							</button>
						</span>
					</div>
				</div>
				{{if .Commit.Signature}}
					{{/* Forgejo's signature details from commit_header: who signed the commit with which key, or why it is not verified. */}}
					{{$signClass := "sign-unverified"}}
					{{if .Verification.Verified}}
						{{if eq .Verification.TrustStatus "trusted"}}
							{{$signClass = "sign-trusted"}}
						{{else if eq .Verification.TrustStatus "untrusted"}}
							{{$signClass = "sign-untrusted"}}
						{{else}}
							{{$signClass = "sign-unmatched"}}
						{{end}}
					{{else if .Verification.Warning}}
						{{$signClass = "sign-warning"}}
					{{end}}
					<div class="commit-signature-row {{$signClass}}">
						<div class="commit-signature-signer">
							{{if .Verification.Verified}}
								{{svg "octicon-verified" 16 "commit-signature-icon"}}
								{{if ne .Verification.SigningUser.ID 0}}
									{{if eq .Verification.TrustStatus "trusted"}}
										<span>{{ctx.Locale.Tr "repo.commits.signed_by"}}:</span>
									{{else if eq .Verification.TrustStatus "untrusted"}}
										<span>{{ctx.Locale.Tr "repo.commits.signed_by_untrusted_user"}}:</span>
									{{else}}
										<span>{{ctx.Locale.Tr "repo.commits.signed_by_untrusted_user_unmatched"}}:</span>
									{{end}}
									{{ctx.AvatarUtils.Avatar .Verification.SigningUser 20}}
									<a href="{{.Verification.SigningUser.HomeLink}}">{{.Verification.SigningUser.GetDisplayName}}</a>
								{{else}}
									<span data-tooltip-content="{{ctx.Locale.Tr "gpg.default_key"}}">{{ctx.Locale.Tr "repo.commits.signed_by"}}:</span>
									{{ctx.AvatarUtils.AvatarByEmail .Verification.SigningEmail "" 20}}
									<strong>{{.Verification.SigningUser.GetDisplayName}}</strong>
								{{end}}
							{{else}}
								{{svg "octicon-unverified" 16 "commit-signature-icon"}}
								<span>{{ctx.Locale.Tr .Verification.Reason}}</span>
							{{end}}
						</div>
						{{/* A verified or warned signature names the key it was checked with; an unverified one names any key it carries. */}}
						{{$checkedKey := or .Verification.Verified .Verification.Warning}}
						{{if and .Verification.SigningKey .Verification.SigningKey.KeyID (not (and $checkedKey .Verification.SigningSSHKey))}}
							<div class="commit-signature-key">
								{{svg "octicon-key" 16}}
								<span>{{ctx.Locale.Tr "repo.commits.gpg_key_id"}}:</span>
								<code>{{.Verification.SigningKey.PaddedKeyID}}</code>
							</div>
						{{end}}
						{{if and .Verification.SigningSSHKey .Verification.SigningSSHKey.Fingerprint}}
							<div class="commit-signature-key">
								{{svg "octicon-key" 16}}
								<span>{{ctx.Locale.Tr "repo.commits.ssh_key_fingerprint"}}:</span>
								<code>{{.Verification.SigningSSHKey.Fingerprint}}</code>
							</div>
						{{end}}
					</div>
				{{end}}
				{{if not .DiffNotAvailable}}
					<div class="commit-stats-row">
						<div class="commit-files-changed" data-tooltip-content="{{ctx.Locale.Tr "repo.pulls.tab_files"}}">{{svg "octicon-file-diff" 16}}{{.DiffMetadata.TotalNumberOfFiles}}</div>
						{{template "repo/diff/change_summary" dict "Addition" .Diff.TotalAddition "Deletion" .Diff.TotalDeletion}}
					</div>
				{{end}}
			</div>
		</section>

		{{if .NoteRendered}}
			<div class="commit-note">
				<div class="ui top attached header segment git-notes tw-flex tw-gap-1 tw-flex-wrap">
					{{svg "octicon-note" 16 "tw-mr-2"}}
					{{ctx.Locale.Tr "repo.diff.git-notes"}}:
					{{if .NoteAuthor}}
						<a href="{{.NoteAuthor.HomeLink}}">
							{{if .NoteAuthor.FullName}}
								<strong>{{.NoteAuthor.FullName}}</strong>
							{{else}}
								<strong>{{.NoteCommit.Author.Name}}</strong>
							{{end}}
						</a>
					{{else}}
						<strong>{{.NoteCommit.Author.Name}}</strong>
					{{end}}
					<span class="text grey tw-flex-1" id="note-authored-time">{{DateUtils.TimeSince .NoteCommit.Author.When}}</span>
					{{if and ($.Permission.CanWrite $.UnitTypeCode) (not $.Repository.IsArchived) (not .IsDeleted)}}
						<div class="ui tw-flex tw-items-center">
							<button id="commit-notes-edit-button" class="ui tiny primary button tw-py-[6px] tw-px-[10px]">{{ctx.Locale.Tr "edit"}}</button>
							<button class="ui tiny button red show-modal tw-py-[6px] tw-px-[10px]" data-modal="#delete-note-modal">{{ctx.Locale.Tr "remove"}}</button>
						</div>
						<dialog id="delete-note-modal">
							<article>
								<header>{{ctx.Locale.Tr "repo.diff.git-notes.remove-header"}}</header>
								<div class="content">
									<p>{{ctx.Locale.Tr "repo.diff.git-notes.remove-body"}}</p>
								</div>
								<form action="{{.Link}}/notes/remove" method="post">
									<div class="actions">
										<button type="button" class="ui cancel button">{{ctx.Locale.Tr "settings.cancel"}}</button>
										<button type="submit" class="ui red button">{{ctx.Locale.Tr "remove"}}</button>
									</div>
								</form>
							</article>
						</dialog>
					{{end}}
				</div>
				<div id="commit-notes-display-area" class="ui bottom attached info segment git-notes">
					<pre class="commit-body">{{.NoteRendered | SanitizeHTML}}</pre>
				</div>
			</div>
		{{end}}
		{{if and ($.Permission.CanWrite $.UnitTypeCode) (not $.Repository.IsArchived) (not .IsDeleted)}}
			<div id="commit-notes-edit-area" class="ui bottom attached info segment git-notes tw-hidden">
				<form id="commit-notes-edit-form" class="ui form" action="{{.Link}}/notes" method="post">
					<div class="field">
						<textarea name="notes">{{.NoteRaw}}</textarea>
					</div>
					<div class="field">
						<div class="text right edit">
							<button id="commit-notes-cancel-button" type="button" class="ui cancel button">{{ctx.Locale.Tr "cancel"}}</button>
							<button id="commit-notes-save-button" type="submit" class="ui primary button">{{if .NoteRaw}}{{ctx.Locale.Tr "save"}}{{else}}{{ctx.Locale.Tr "add"}}{{end}}</button>
						</div>
					</div>
				</form>
			</div>
		{{end}}

		<div class="commit-diff">
			{{template "repo/diff/box" .}}
		</div>
	</div>
</div>
{{template "base/footer" .}}
