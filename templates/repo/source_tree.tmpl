<aside class="repo-source-panel">
    <div class="repo-source-title"><button type="button" class="theme-icon-button" data-source-tree-toggle data-hide-label="{{ctx.Locale.Tr "repo.diff.hide_file_tree"}}" data-show-label="{{ctx.Locale.Tr "repo.diff.show_file_tree"}}" aria-expanded="true" aria-label="{{ctx.Locale.Tr "repo.diff.hide_file_tree"}}">{{svg "octicon-sidebar-expand" 16}}</button><h2>{{ctx.Locale.Tr "repo.code"}}</h2></div>
    <div class="repo-source-branch">{{template "repo/branch_dropdown" dict "root" .}}{{template "components/repository/compare/compare" .}}<a class="theme-icon-button theme-icon-button-outlined" href="{{.RepoLink}}/search/{{if .IsViewCommit}}branch/{{PathEscapeSegments .Repository.DefaultBranch}}{{else}}{{.BranchNameSubURL}}{{end}}" aria-label="{{ctx.Locale.Tr "search.code_kind"}}">{{svg "octicon-search" 16}}</a></div>
    {{template "repo/file_picker" .}}
    <nav id="repo-source-tree" class="file-tree repo-source-tree" aria-label="{{ctx.Locale.Tr "repo.code"}}" data-source-url="{{.RepoLink}}/src/{{.BranchNameSubURL}}" data-current-path="{{.TreePath}}">
        <div class="repo-source-tree-status" role="status" data-error="{{ctx.Locale.Tr "error.network_error"}}">{{ctx.Locale.Tr "loading"}}</div>
        {{/* Read the same authorized commit as the page, without API authentication or file-picker filtering. */}}
        <template id="repo-source-tree-data">
            {{range .Context.Repo.Commit.ListEntriesRecursiveFast}}
                <span data-path="{{.Name}}" data-directory="{{.IsDir}}"></span>
            {{end}}
        </template>
        <div class="file-tree-items" role="tree" aria-label="{{ctx.Locale.Tr "repo.code"}}"></div>
    </nav>
    <template id="repo-tree-file">{{svg "octicon-file" 16 "tree-file-icon"}}</template>
    <template id="repo-tree-folder">{{svg "octicon-file-directory-fill" 16}}</template>
    <template id="repo-tree-folder-open">{{svg "octicon-file-directory-open-fill" 16 "tree-directory-icon"}}</template>
    <template id="repo-tree-chevron-right">{{svg "octicon-chevron-right" 12}}</template>
    <template id="repo-tree-chevron-down">{{svg "octicon-chevron-down" 12}}</template>
</aside>
{{/* Not deferred: the tree is built before the main content is parsed, so it never shows an empty panel. */}}
<script src="{{AssetUrlPrefix}}/js/repo-source-browser.js"></script>
<script src="{{AssetUrlPrefix}}/js/resizable-divider.js" defer></script>
<script src="{{AssetUrlPrefix}}/js/tree-navigation.js" defer></script>
<script src="{{AssetUrlPrefix}}/js/repo-source-navigation.js" defer></script>
