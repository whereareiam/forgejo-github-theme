{{template "base/head" .}}
{{/* GitHub's releases page: the shared sidebar with Releases, Tags and the releases on this page, and the list in
	the main column. A single release (/releases/tag/…) uses this template too, with a breadcrumb for its heading. */}}
{{$single := StringUtils.Contains .Link "/releases/tag/"}}
<div role="main" aria-label="{{.Title}}" class="page-content repository releases github-releases theme-sidebar-layout{{if $single}} github-release-single{{end}}" data-theme-sidebar="releases_sidebar_collapsed">
	{{template "repo/release/sidebar" .}}
	<div class="ui container theme-sidebar-main github-releases-main">
		{{template "base/alert" .}}
		<div class="theme-list-heading github-release-heading">
			<div class="theme-list-title">
				<button type="button" class="theme-icon-button" data-theme-sidebar-toggle data-theme-sidebar-expand aria-expanded="false" aria-label="Expand sidebar">{{svg "octicon-sidebar-expand" 16}}</button>
				{{if and $single .Releases}}
					<nav class="github-release-breadcrumb" aria-label="Breadcrumb">
						<a href="{{.RepoLink}}/{{if .PageIsSingleTag}}tags{{else}}releases{{end}}">{{if .PageIsSingleTag}}{{ctx.Locale.Tr "repo.tags"}}{{else}}{{ctx.Locale.Tr "repo.releases"}}{{end}}</a>
						<span class="github-release-breadcrumb-separator">/</span>
						<h1 aria-current="page">{{(index .Releases 0).Release.Title}}</h1>
					</nav>
				{{else}}
					<h1>{{ctx.Locale.Tr "repo.releases"}}</h1>
				{{end}}
			</div>
			{{if not $single}}
				<div class="github-release-actions">
					{{if .ShowReleaseSearch}}<form class="ignore-dirty github-release-search" method="get" role="search">{{template "components/common/search/search" dict "Kind" "icon" "Value" .Keyword "Placeholder" "Find a release"}}</form>{{end}}
					{{if .EnableFeed}}<a class="theme-icon-button theme-icon-button-outlined" href="{{.RepoLink}}/releases.rss" aria-label="{{ctx.Locale.Tr "rss_feed"}}" data-tooltip-content="{{ctx.Locale.Tr "rss_feed"}}">{{svg "octicon-rss" 16}}</a>{{end}}
					{{if .CanCreateRelease}}<a class="button theme-control" href="{{$.RepoLink}}/releases/new">Draft a new release</a>{{end}}
				</div>
			{{end}}
		</div>
		{{if .Releases}}
			<ul class="github-release-list">
				{{range $idx, $info := .Releases}}
					{{$release := $info.Release}}
					{{$canReadCode := $.Permission.CanRead $.UnitTypeCode}}
					<li id="release-{{$release.ID}}" class="github-release">
						<div class="github-release-header">
							<h2 class="github-release-title">
								<a href="{{$.RepoLink}}/releases/tag/{{$release.TagName | PathEscapeSegments}}">{{$release.Title}}</a>
								{{if $release.IsDraft}}
									<span class="ui label github-release-draft theme-label theme-label-large theme-label-solid">{{ctx.Locale.Tr "repo.release.draft"}}</span>
								{{else if $release.IsPrerelease}}
									<span class="ui orange label theme-label theme-label-large">{{ctx.Locale.Tr "repo.release.prerelease"}}</span>
								{{else if not $release.IsTag}}
									<a class="github-release-latest" href="{{$.RepoLink}}/releases/latest" hidden><span class="ui green label theme-label theme-label-large">Latest</span></a>
								{{end}}
							</h2>
							<div class="github-release-controls">
								{{if and $release.Sha1 $canReadCode}}{{template "repo/branch_dropdown" dict "root" $ "release" $release}}{{end}}
								{{if and $.CanCreateRelease (not $release.IsTag)}}
									<a class="theme-icon-button theme-icon-button-outlined" aria-label="{{ctx.Locale.Tr "repo.release.edit"}}: {{$release.Title}}" data-tooltip-content="{{ctx.Locale.Tr "repo.release.edit"}}" href="{{$.RepoLink}}/releases/edit/{{$release.TagName | PathEscapeSegments}}" rel="nofollow">{{svg "octicon-pencil" 16}}</a>
									<button type="button" class="theme-icon-button theme-icon-button-outlined github-release-delete delete-button" aria-label="{{ctx.Locale.Tr "repo.release.deletion"}}: {{$release.Title}}" data-tooltip-content="{{ctx.Locale.Tr "repo.release.deletion"}}" data-url="{{$.RepoLink}}/releases/delete" data-id="{{$release.ID}}" data-modal-id="delete-release-{{$idx}}">{{svg "octicon-trash" 16}}</button>
								{{end}}
							</div>
						</div>
						<div class="github-release-meta">
							<p class="github-release-byline">
								<span class="author">
									{{if $release.OriginalAuthor}}
										{{svg (MigrationIcon $release.Repo.GetOriginalURLHostname) 20}}{{$release.OriginalAuthor}}
									{{else if $release.Publisher}}
										{{ctx.AvatarUtils.Avatar $release.Publisher 20}}
										{{template "shared/user/authorlink" $release.Publisher}}
									{{else}}
										<!-- Fake the Ghost user -->
										{{template "shared/user/authorlink" (dict "ID" -1)}}
									{{end}}
								</span>
								<span class="released">{{if $release.IsDraft}}drafted this{{else}}{{ctx.Locale.Tr "repo.released_this"}}{{end}}</span>
								{{if $release.CreatedUnix}}<span class="time">{{DateUtils.TimeSince $release.CreatedUnix}}</span>{{end}}
							</p>
							{{$showRefs := and $release.Sha1 $canReadCode}}
							{{$showAhead := and (not $release.IsDraft) $canReadCode}}
							{{if or $showRefs $info.CommitStatuses $showAhead}}
								<div class="github-release-refs">
									{{if $showRefs}}
										<a class="github-release-ref" href="{{$.RepoLink}}/src/tag/{{$release.TagName | PathEscapeSegments}}">{{svg "octicon-tag" 16}}<span>{{$release.TagName}}</span></a>
										<a class="github-release-ref tw-font-mono" href="{{$.RepoLink}}/src/commit/{{$release.Sha1}}">{{svg "octicon-git-commit" 16}}<span>{{ShortSha $release.Sha1}}</span></a>
									{{end}}
									{{template "repo/commit_statuses" dict "Status" $info.CommitStatus "Statuses" $info.CommitStatuses "AdditionalClasses" "github-release-status" "StatusLabel" true}}
									{{if $showAhead}}
										<a class="github-release-ref github-release-ahead" href="{{$.RepoLink}}/compare/{{$release.TagName | PathEscapeSegments}}...{{$release.TargetBehind | PathEscapeSegments}}" data-tooltip-content="{{ctx.Locale.Tr "repo.release.ahead.commits" $release.NumCommitsBehind}} {{ctx.Locale.Tr "repo.release.ahead.target" $release.TargetBehind}}">{{svg "octicon-diff" 16}}<span>{{ctx.Locale.Tr "repo.release.ahead.commits" $release.NumCommitsBehind}}</span></a>
									{{end}}
								</div>
							{{end}}
							{{template "repo/tag/verification_line" (dict "ctxData" $ "release" $release)}}
						</div>
						{{if $release.RenderedNote}}
							<div class="markup desc github-release-notes">
								{{$release.RenderedNote}}
							</div>
						{{end}}
						{{$hasReleaseAttachment := gt (len $release.Attachments) 0}}
						{{$hasArchiveLinks := and (not $.DisableDownloadSourceArchives) (not $release.IsDraft) (not $release.HideArchiveLinks) $canReadCode}}
						{{if or $hasArchiveLinks $hasReleaseAttachment}}
							<details class="github-release-assets"{{if eq $idx 0}} open{{end}}>
								<summary>
									{{svg "octicon-triangle-right" 16 "github-release-assets-marker"}}<span>Assets</span>
									<span class="theme-counter github-release-asset-count">{{if $hasArchiveLinks}}{{Eval (len $release.Attachments) "+" 2}}{{else}}{{len $release.Attachments}}{{end}}</span>
								</summary>
								<ul class="github-release-asset-list">
									{{range $release.Attachments}}
										{{if .ExternalURL}}
											<li class="github-release-asset">
												<a class="github-release-asset-name" target="_blank" rel="nofollow" href="{{.DownloadURL}}">{{svg "octicon-link-external" 16}}<span>{{.Name}}</span></a>
											</li>
										{{else}}
											<li class="github-release-asset">
												<a class="github-release-asset-name" target="_blank" rel="nofollow" href="{{.DownloadURL}}" download>{{svg "octicon-package" 16}}<span>{{.Name}}</span></a>
												<span class="github-release-asset-downloads" data-tooltip-content="{{ctx.Locale.TrPluralString .DownloadCount "release.n_downloads" (ctx.Locale.PrettyNumber .DownloadCount)}}">{{ctx.Locale.PrettyNumber .DownloadCount}} {{svg "octicon-download" 16}}</span>
												<span class="github-release-asset-size">{{.Size | ctx.Locale.TrSize}}</span>
												<span class="github-release-asset-date">{{DateUtils.TimeSince .CreatedUnix}}</span>
											</li>
										{{end}}
									{{end}}
									{{if $hasArchiveLinks}}
										<li class="github-release-asset">
											<a class="archive-link github-release-asset-name" href="{{$.RepoLink}}/archive/{{$release.TagName | PathEscapeSegments}}.zip" rel="nofollow" type="application/zip">{{svg "octicon-file-zip" 16}}<span>{{ctx.Locale.Tr "repo.release.source_code"}} (zip)</span></a>
											<span class="github-release-asset-downloads" data-tooltip-content="{{ctx.Locale.TrPluralString $release.ArchiveDownloadCount.Zip "release.n_downloads" (ctx.Locale.PrettyNumber $release.ArchiveDownloadCount.Zip)}}">{{ctx.Locale.PrettyNumber $release.ArchiveDownloadCount.Zip}} {{svg "octicon-download" 16}}</span>
											<span class="github-release-asset-date">{{DateUtils.TimeSince $release.CreatedUnix}}</span>
										</li>
										<li class="github-release-asset">
											<a class="archive-link github-release-asset-name" href="{{$.RepoLink}}/archive/{{$release.TagName | PathEscapeSegments}}.tar.gz" rel="nofollow" type="application/gzip">{{svg "octicon-file-zip" 16}}<span>{{ctx.Locale.Tr "repo.release.source_code"}} (tar.gz)</span></a>
											<span class="github-release-asset-downloads" data-tooltip-content="{{ctx.Locale.TrPluralString $release.ArchiveDownloadCount.TarGz "release.n_downloads" (ctx.Locale.PrettyNumber $release.ArchiveDownloadCount.TarGz)}}">{{ctx.Locale.PrettyNumber $release.ArchiveDownloadCount.TarGz}} {{svg "octicon-download" 16}}</span>
											<span class="github-release-asset-date">{{DateUtils.TimeSince $release.CreatedUnix}}</span>
										</li>
									{{end}}
								</ul>
							</details>
						{{end}}
					</li>
				{{end}}
			</ul>
		{{else}}
			<div class="theme-empty github-release-empty">
				{{svg "octicon-tag" 32}}
				<h2>{{if .Keyword}}No releases found{{else}}There aren’t any releases here{{end}}</h2>
				<p>{{if .Keyword}}Try a different search.{{else}}Releases package software, release notes, and downloads for your project.{{end}}</p>
				{{if .Keyword}}<a href="{{.RepoLink}}/releases">View all releases</a>{{end}}
			</div>
		{{end}}

		{{range $idx, $info := .Releases}}
			{{$release := $info.Release}}
			{{if and $.CanCreateRelease (not $release.IsTag)}}
				<div class="ui g-modal-confirm delete modal" id="delete-release-{{$idx}}">
					<div class="header">{{svg "octicon-trash"}} {{ctx.Locale.Tr "repo.release.deletion"}}</div>
					<div class="content"><p>{{ctx.Locale.Tr "repo.release.deletion_desc"}}</p></div>
					{{template "base/modal_actions_confirm" $}}
				</div>
			{{end}}
		{{end}}

		{{template "base/paginate" .}}
	</div>
</div>

<script src="{{AssetUrlPrefix}}/js/repo-releases.js" defer></script>
{{template "base/footer" .}}
