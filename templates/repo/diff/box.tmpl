{{/* Only the compare route sets CompareSeparator; GitHub's compare view has no file tree and a "Showing..." summary. */}}
{{$isCompare := .CompareSeparator}}
{{$showFileTree := (and (not .DiffNotAvailable) (gt .DiffMetadata.TotalNumberOfFiles 0) (not $isCompare))}}
<div>
	{{if not .DiffNotAvailable}}
		{{if and .IsShowingOnlySingleCommit .PageIsPullFiles}}
			<div class="ui info message">
				<div>{{ctx.Locale.Tr "repo.pulls.showing_only_single_commit" (ShortSha .CommitID)}} - <a href="{{$.Issue.Link}}/files?style={{if $.IsSplitStyle}}split{{else}}unified{{end}}&whitespace={{$.WhitespaceBehavior}}&show-outdated={{$.ShowOutdatedComments}}">{{ctx.Locale.Tr "repo.pulls.show_all_commits"}}</a></div>
			</div>
		{{else if and (not .IsShowingAllCommits) .PageIsPullFiles}}
			<div class="ui info message">
				<div>{{ctx.Locale.Tr "repo.pulls.showing_specified_commit_range" (ShortSha .BeforeCommitID) (ShortSha .AfterCommitID)}} - <a href="{{$.Issue.Link}}/files?style={{if $.IsSplitStyle}}split{{else}}unified{{end}}&whitespace={{$.WhitespaceBehavior}}&show-outdated={{$.ShowOutdatedComments}}">{{ctx.Locale.Tr "repo.pulls.show_all_commits"}}</a></div>
			</div>
		{{end}}
		<script id="diff-data-script" type="module">
			const diffDataFiles = [{{range $i, $file := .DiffFileMetadata}}{Name:"{{$file.Name}}",NameHash:"{{$file.NameHash}}",Type:{{$file.Type}},OnPage:{{$file.OnPage}},IsViewed:{{$file.IsViewed}}},{{end}}];
			const diffData = {
				tooManyFilesMessage: "{{ctx.Locale.Tr "repo.diff.too_many_files"}}",
				binaryFileMessage: "{{ctx.Locale.Tr "repo.diff.bin"}}",
				showMoreMessage: "{{ctx.Locale.Tr "repo.diff.show_more"}}",
				statisticsMessage: "{{ctx.Locale.Tr "repo.diff.stats_desc_file"}}",
				currentPage: {{.DiffMetadata.CurrentPage}},
			};

			// for first time loading, the diffFileInfo is a plain object
			// after the Vue component is mounted, the diffFileInfo is a reactive object
			// keep in mind that this script block would be executed many times when loading more files, by "loadMoreFiles"
			let diffFileInfo = window.config.pageData.diffFileInfo || {
				files:[],
				fileTreeIsVisible: false,
				fileListIsVisible: false,
				isLoadingNewData: false,
				selectedItem: '',
			};
			diffFileInfo = Object.assign(diffFileInfo, diffData);
			diffFileInfo.files.push(...diffDataFiles);
			window.config.pageData.diffFileInfo = diffFileInfo;
		</script>
		{{end}}
		{{if $showFileTree}}
			<script>
				// Default to true if unset. The tree and its toggle use this initial state.
				const diffTreeVisible = localStorage?.getItem('diff_file_tree_visible') !== 'false';
			</script>
		{{end}}
		{{if and $isCompare (not .DiffNotAvailable)}}
			<div class="diff-compare-stats">
				<span>{{svg "octicon-file-diff" 16}}Showing {{ctx.Locale.Tr "repo.diff.stats_desc" .DiffMetadata.TotalNumberOfFiles .Diff.TotalAddition .Diff.TotalDeletion}}.</span>
				<div class="diff-compare-style">
					<a class="{{if .IsSplitStyle}}active{{end}}" href="?style=split&amp;whitespace={{.WhitespaceBehavior}}">Split</a>
					<a class="{{if not .IsSplitStyle}}active{{end}}" href="?style=unified&amp;whitespace={{.WhitespaceBehavior}}">Unified</a>
				</div>
			</div>
		{{end}}
		<div id="diff-container"{{if $showFileTree}} class="diff-has-file-tree"{{end}}>
			{{/* GitHub's toolbar spans the tree and the files, in the first row of the #diff-container grid. */}}
			<div class="diff-detail-box diff-box diff-content-controls">
				<div class="diff-content-controls-left">
					{{if $showFileTree}}
						<button class="diff-toggle-file-tree-button theme-icon-button not-mobile" data-show-text="{{ctx.Locale.Tr "repo.diff.show_file_tree"}}" data-hide-text="{{ctx.Locale.Tr "repo.diff.hide_file_tree"}}">
							{{/* the icon meaning is reversed here, "octicon-sidebar-collapse" means show the file tree */}}
							{{svg "octicon-sidebar-collapse" 16 "icon tw-hidden"}}
							{{svg "octicon-sidebar-expand" 16 "icon tw-hidden"}}
						</button>
					{{end}}
					{{if .PageIsPullFiles}}
						{{/* Vue replaces the button inside; CSS draws the label from this variable. */}}
						<div id="diff-commit-select" style="--diff-commit-label: '{{if .IsShowingOnlySingleCommit}}{{ShortSha .CommitID}}{{else if not .IsShowingAllCommits}}{{ShortSha .BeforeCommitID}}..{{ShortSha .AfterCommitID}}{{else}}{{ctx.Locale.Tr "repo.commits.commits"}}{{end}}'" data-issuelink="{{$.Issue.Link}}" data-queryparams="?style={{if $.IsSplitStyle}}split{{else}}unified{{end}}&whitespace={{$.WhitespaceBehavior}}&show-outdated={{$.ShowOutdatedComments}}" data-filter_changes_by_commit="{{ctx.Locale.Tr "repo.pulls.filter_changes_by_commit"}}">
							{{/*
								the following will be replaced by vue component
								but this avoids any loading artifacts till the vue component is initialized
							*/}}
							<div class="ui jump dropdown basic button custom">
								{{svg "octicon-git-commit"}}
							</div>
						</div>
					{{end}}
					<div class="diff-code-search">
						{{template "components/common/search/search" dict "Kind" "icon" "Local" true "ID" "diff-code-search" "Placeholder" "Search within code"}}
						<div class="diff-search-navigation" hidden><span id="diff-search-count" role="status"></span><button class="btn interact-bg" type="button" data-search-direction="-1" aria-label="Previous match">{{svg "octicon-chevron-up" 16}}</button><button class="btn interact-bg" type="button" data-search-direction="1" aria-label="Next match">{{svg "octicon-chevron-down" 16}}</button></div>
					</div>
				</div>
				<div class="diff-content-controls-right diff-detail-actions button-row">
					{{if and .PageIsPullFiles $.SignedUserID (not .IsArchived) (not .DiffNotAvailable)}}
						<div class="diff-viewed-summary not-mobile">
							{{/* Forgejo updates the hidden progress; diff-view.js mirrors its value onto the ring. */}}
							<span class="diff-viewed-ring" aria-hidden="true"></span>
							<label for="viewed-files-summary" id="viewed-files-summary-label" data-text-changed-template="{{ctx.Locale.Tr "repo.pulls.viewed_files_label"}}">
								{{ctx.Locale.Tr "repo.pulls.viewed_files_label" .DiffMetadata.NumberOfViewedFiles .DiffMetadata.TotalNumberOfFiles}}
							</label>
							<progress id="viewed-files-summary" value="{{.DiffMetadata.NumberOfViewedFiles}}" max="{{.DiffMetadata.TotalNumberOfFiles}}"></progress>
						</div>
					{{end}}
					{{if and .PageIsPullFiles $.SignedUserID (not .IsArchived)}}
						{{template "repo/diff/new_review" .}}
					{{end}}
					{{template "repo/diff/view_settings" .}}
				</div>
			</div>
			{{if $showFileTree}}
				<div class="diff-file-tree-panel not-mobile">
					<div class="diff-file-tree-scroll">
						<div class="diff-file-tree-controls">
                            {{template "components/common/search/search" dict "Kind" "icon" "Local" true "ID" "diff-tree-filter" "Placeholder" "Filter files…" "Label" "Filter files"}}
                            <details class="theme-menu diff-tree-options">
                                <summary class="theme-icon-button theme-icon-button-outlined" aria-label="Filter options">{{svg "octicon-filter" 16}}</summary>
                                <div class="theme-menu-popover"></div>
                            </details>
                        </div>
						<div id="diff-file-tree" class="file-tree tw-hidden"></div>
                        <p class="diff-tree-empty" role="status" hidden>No files found.</p>
					</div>
				</div>
				<script>
					if (diffTreeVisible) document.getElementById('diff-file-tree').classList.remove('tw-hidden');
					else document.getElementById('diff-container').classList.add('diff-file-tree-hidden');
					// The toggle sits in the toolbar above, so its first state is set here, once the tree exists; diff-file-tree.js
					// keeps it in sync afterwards. Phones start with the tree closed.
					const diffTreeBtn = document.querySelector('.diff-toggle-file-tree-button');
					const diffTreeIcon = `.octicon-sidebar-${diffTreeVisible ? 'expand' : 'collapse'}`;
					diffTreeBtn.querySelector(diffTreeIcon).classList.remove('tw-hidden');
					diffTreeBtn.classList.toggle('active', diffTreeVisible && !matchMedia('(max-width: 767.98px)').matches);
					diffTreeBtn.setAttribute('data-tooltip-content', diffTreeBtn.getAttribute(diffTreeVisible ? 'data-hide-text' : 'data-show-text'));
				</script>
				<div class="resizable-divider not-mobile" role="separator" aria-label="Resize file tree" aria-orientation="vertical" aria-valuemin="200" aria-valuenow="296" aria-valuemax="480" data-resize-container="#diff-container" data-resize-content-minimum-width="320" data-resize-default-width="296" data-resize-maximum-width="480" data-resize-minimum-width="200" data-resize-storage-key="diff_file_tree_width" data-resize-variable="--diff-file-tree-width" tabindex="0"></div>
			{{end}}
			<div id="diff-content-container">
				<div class="diff-content-body">
					{{if .IsShowingOnlySingleCommit}}
						<div id="diff-commit-header">
							{{template "repo/commit_header" .}}
						</div>
					{{end}}
					{{if .DiffNotAvailable}}
						<h4>{{ctx.Locale.Tr "repo.diff.data_not_available"}}</h4>
					{{else}}
						<div id="diff-file-boxes" class="sixteen wide column">
				{{range $i, $file := .Diff.Files}}
					{{/*notice: the index of Diff.Files should not be used for element ID, because the index will be restarted from 0 when doing load-more for PRs with a lot of files*/}}
					{{$blobBase := call $.GetBlobByPathForCommit $.BeforeCommit $file.OldName}}
					{{$blobHead := call $.GetBlobByPathForCommit $.HeadCommit $file.Name}}
					{{$sniffedTypeBase := call $.GetSniffedTypeForBlob $blobBase}}
					{{$sniffedTypeHead := call $.GetSniffedTypeForBlob $blobHead}}
					{{$isImage:= or (call $.IsSniffedTypeAnImage $sniffedTypeBase) (call $.IsSniffedTypeAnImage $sniffedTypeHead)}}
					{{$isCsv := (call $.IsCsvFile $file)}}
					{{$showFileViewToggle := or $isImage (and (not $file.IsIncomplete) $isCsv)}}
					{{$isExpandable := or (gt $file.Addition 0) (gt $file.Deletion 0) $file.IsBin}}
					{{$isReviewFile := and $.IsSigned $.PageIsPullFiles (not $.IsArchived) $.IsShowingAllCommits}}
					<div class="diff-file-box diff-box file-content {{TabSizeClass $.Editorconfig $file.Name}} tw-mt-0" id="diff-{{$file.NameHash}}" data-old-filename="{{$file.OldName}}" data-new-filename="{{$file.Name}}" {{if and $file.IsDeleted (not $file.IsBin)}}data-deleted-diff-hidden{{end}} {{if or ($file.ShouldBeHidden) (not $isExpandable)}}data-folded="true"{{end}}>
						{{template "repo/diff/file_header" dict "file" $file "root" $ "isExpandable" $isExpandable "isReviewFile" $isReviewFile "showFileViewToggle" $showFileViewToggle}}
                        {{if and $file.IsDeleted (not $file.IsBin)}}
                            <div class="diff-deleted-placeholder">
                                <div class="diff-deleted-skeleton" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
                                <button type="button" class="btn diff-load-deleted">Load diff</button>
                                <span>This file was deleted.</span>
                            </div>
                        {{end}}
						<div class="diff-file-body ui attached unstackable table segment" {{if and $file.IsViewed $.IsShowingAllCommits}}data-folded="true"{{end}}>
							<div id="diff-source-{{$file.NameHash}}" class="file-body file-code unicode-escaped code-diff{{if $.IsSplitStyle}} code-diff-split{{else}} code-diff-unified{{end}}{{if $showFileViewToggle}} tw-hidden{{end}}">
								{{if or $file.IsIncomplete $file.IsBin}}
									<div class="diff-file-body binary{{if $file.IsIncomplete}} diff-suppressed-placeholder{{end}}">
										{{if $file.IsIncomplete}}
											{{/* GitHub's large diff placeholder. Forgejo replaces the parent of a.diff-load-button with the loaded
												diff and reads data-href from the clicked element, so the link stays a direct child holding text only. */}}
											<div class="diff-deleted-skeleton" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
											{{if $file.IsIncompleteLineTooLong}}
												<span>{{ctx.Locale.Tr "repo.diff.file_suppressed_line_too_long"}}</span>
											{{else}}
												<a class="diff-load-button" role="button" href="#" data-href="?file-only=true&files={{$file.Name}}&files={{$file.OldName}}">{{ctx.Locale.Tr "repo.diff.load"}}</a>
												<span>Large diffs are not rendered by default.</span>
											{{end}}
										{{else}}
											{{ctx.Locale.Tr "repo.diff.bin_not_shown"}}
										{{end}}
									</div>
								{{else}}
									<table class="chroma" data-new-comment-url="{{$.Issue.Link}}/files/reviews/new_comment?before_commit_id={{$.BeforeCommitID}}&after_commit_id={{$.AfterCommitID}}" data-path="{{$file.Name}}">
										{{if $.IsSplitStyle}}
											{{template "repo/diff/section_split" dict "file" . "root" $}}
										{{else}}
											{{template "repo/diff/section_unified" dict "file" . "root" $}}
										{{end}}
									</table>
								{{end}}
							</div>
							{{if $showFileViewToggle}}
								{{/* for image or CSV, it can have a horizontal scroll bar, there won't be review comment context menu (position absolute) which would be clipped by "overflow" */}}
								<div id="diff-rendered-{{$file.NameHash}}" class="file-body file-code {{if $.IsSplitStyle}}code-diff-split{{else}}code-diff-unified{{end}} tw-overflow-x-scroll">
									<table class="chroma tw-w-full">
										{{if $isImage}}
											{{template "repo/diff/image_diff" dict "file" . "root" $ "blobBase" $blobBase "blobHead" $blobHead "sniffedTypeBase" $sniffedTypeBase "sniffedTypeHead" $sniffedTypeHead}}
										{{else}}
											{{template "repo/diff/csv_diff" dict "file" . "root" $ "blobBase" $blobBase "blobHead" $blobHead "sniffedTypeBase" $sniffedTypeBase "sniffedTypeHead" $sniffedTypeHead}}
										{{end}}
									</table>
								</div>
							{{end}}
						</div>
					</div>
				{{end}}

			</div>
			{{if .DiffMetadata.HasNext}}
				{{/* GitHub loads the next files while scrolling: diff-view.js presses the hidden "Show more" link. */}}
				<div class="diff-loading-more" id="diff-incomplete" role="status">
					<span class="diff-loading-spinner" aria-hidden="true"></span>
					<span>Loading more files…</span>
					<a class="tw-hidden" id="diff-show-more-files" data-href="?{{range $i, $f := .FileSelection}}{{if $i}}&{{end}}files={{$f}}{{end}}&diff-page={{len (printf "a%*s" .DiffMetadata.CurrentPage "")}}&file-only=true">{{ctx.Locale.Tr "repo.diff.show_more"}}</a>
				</div>
			{{end}}
		{{end}}
		</div>
			</div>
		</div>
        <script src="{{AssetUrlPrefix}}/js/diff-view.js" defer></script>
		{{if $showFileTree}}
			<script src="{{AssetUrlPrefix}}/js/resizable-divider.js" defer></script>
            <script src="{{AssetUrlPrefix}}/js/diff-file-tree.js" defer></script>
            <script src="{{AssetUrlPrefix}}/js/tree-navigation.js" defer></script>
            <script src="{{AssetUrlPrefix}}/js/details-menu.js" defer></script>
		{{end}}

		{{if and (not $.Repository.IsArchived) (not .DiffNotAvailable)}}
		<template id="issue-comment-editor-template">
			<div class="ui comment form">
				{{template "shared/combomarkdowneditor" (dict
					"MarkdownPreviewUrl" (print $.Repository.Link "/markup")
					"MarkdownPreviewContext" $.RepoLink
					"TextareaName" "content"
					"DropzoneParentContainer" ".ui.form"
				)}}
				{{if .IsAttachmentEnabled}}
					<div class="field">
						{{template "repo/upload" .}}
					</div>
				{{end}}
				<div class="text right edit buttons">
					<button class="ui cancel button" data-button-name="cancel-edit">{{ctx.Locale.Tr "repo.issues.cancel"}}</button>
					<button class="ui primary save button" data-button-name="save-edit">{{ctx.Locale.Tr "repo.issues.save"}}</button>
				</div>
			</div>
		</template>
	{{end}}
	{{if (not .DiffNotAvailable)}}
		{{template "repo/issue/view_content/reference_issue_dialog" .}}
	{{end}}
</div>
