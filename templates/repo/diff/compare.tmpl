{{template "base/head" .}}
{{/* Forgejo 17 compare.tmpl, laid out like GitHub's "Comparing changes": the Subhead, the range editor with the base and
     compare pickers, the create box with what the pull request would merge and its button on the right, the pull
     request form (repo/issue/new_form, shared with new issues), GitHub's open pull request row, a blank slate for equal
     branches, then the commit and file summary over the commits and the diff. */}}
<div role="main" aria-label="{{.Title}}" class="page-content repository diff github-compare {{if .PageIsComparePull}}compare pull{{end}}">
	{{$showDiffBox := false}}
	{{$canReadPullRequests := .Permission.CanRead $.UnitTypePullRequests}}
	<div class="ui container">
	{{/* GitHub's Subhead: the large title and its description over a divider. */}}
	<div class="theme-compare-header">
		{{if and $.PageIsComparePull $.IsSigned (not .Repository.IsArchived)}}
			{{if $canReadPullRequests}}
				<h1>{{ctx.Locale.Tr "repo.pulls.compare_changes"}}</h1>
				<p>{{ctx.Locale.Tr "repo.pulls.compare_changes_desc"}}</p>
			{{else}}
				<h1>{{ctx.Locale.Tr "compare.branches.title"}}</h1>
			{{end}}
		{{else}}
			<h1>{{ctx.Locale.Tr "action.compare_commits_general"}}</h1>
		{{end}}
	</div>
	{{$BaseCompareName := $.BaseName -}}
	{{- $HeadCompareName := $.HeadRepo.OwnerName -}}
	{{- if and (eq $.BaseName $.HeadRepo.OwnerName) (ne $.Repository.Name $.HeadRepo.Name) -}}
		{{- $HeadCompareName = printf "%s/%s" $.HeadRepo.OwnerName $.HeadRepo.Name -}}
	{{- end -}}
	{{- $OwnForkCompareName := "" -}}
	{{- if .OwnForkRepo -}}
		{{- $OwnForkCompareName = .OwnForkRepo.OwnerName -}}
	{{- end -}}
	{{- $RootRepoCompareName := "" -}}
	{{- if .RootRepo -}}
		{{- $RootRepoCompareName = .RootRepo.OwnerName -}}
		{{- if eq $.HeadRepo.OwnerName .RootRepo.OwnerName -}}
			{{- $HeadCompareName = printf "%s/%s" $.HeadRepo.OwnerName $.HeadRepo.Name -}}
		{{- end -}}
	{{- end -}}
	<div class="ui segment choose branch">
		<a class="tw-mr-2" href="{{$.HeadRepo.Link}}/compare/{{PathEscapeSegments $.HeadBranch}}{{$.CompareSeparator}}{{if not $.PullRequestCtx.SameRepo}}{{PathEscape $.BaseName}}/{{PathEscape $.Repository.Name}}:{{end}}{{PathEscapeSegments $.BaseBranch}}" title="{{ctx.Locale.Tr "repo.pulls.switch_head_and_base"}}">{{svg "octicon-git-compare"}}</a>
		<div class="ui floating filter dropdown" data-no-results="{{ctx.Locale.Tr "repo.pulls.no_results"}}">
			<div class="ui basic small button">
				<span class="text">{{/* GitHub: "base: main"; the owner only matters across forks. */}}<span class="compare-ref-label">{{ctx.Locale.Tr "repo.compare.compare_base"}}:</span> {{if not $.PullRequestCtx.SameRepo}}{{$BaseCompareName}}:{{end}}{{$.BaseBranch}}</span>
				{{svg "octicon-triangle-down" 14 "dropdown icon"}}
			</div>
			<div class="menu">
				<div class="ui icon search input">
					<i class="icon">{{svg "octicon-filter" 16}}</i>
					<input name="search" placeholder="{{ctx.Locale.Tr "repo.filter_branch_and_tag"}}...">
				</div>
				<div class="branch-tag-tab">
					<a class="branch-tag-item muted" href="#" data-target=".base-branch-list">
						{{svg "octicon-git-branch"}}{{ctx.Locale.Tr "repo.branches"}}
					</a>
					<a class="branch-tag-item muted" href="#" data-target=".base-tag-list">
						{{svg "octicon-tag"}}{{ctx.Locale.Tr "repo.tags"}}
					</a>
				</div>
				<div class="scrolling menu reference-list-menu base-branch-list">
					{{range .Branches}}
						<div class="item {{if eq $.BaseBranch .}}selected{{end}}" data-url="{{$.RepoLink}}/compare/{{PathEscapeSegments .}}{{$.CompareSeparator}}{{if not $.PullRequestCtx.SameRepo}}{{PathEscape $.HeadUser.Name}}/{{PathEscape $.HeadRepo.Name}}:{{end}}{{PathEscapeSegments $.HeadBranch}}">{{if not $.PullRequestCtx.SameRepo}}{{$BaseCompareName}}:{{end}}{{.}}</div>
					{{end}}
					{{if and (not .PullRequestCtx.SameRepo) ($.HeadRepo.AllowsPulls ctx)}}
						{{range .HeadBranches}}
							<div class="item" data-url="{{$.HeadRepo.Link}}/compare/{{PathEscapeSegments .}}{{$.CompareSeparator}}{{PathEscape $.HeadUser.Name}}/{{PathEscape $.HeadRepo.Name}}:{{PathEscapeSegments $.HeadBranch}}">{{if not $.PullRequestCtx.SameRepo}}{{$HeadCompareName}}:{{end}}{{.}}</div>
						{{end}}
					{{end}}
					{{if and .OwnForkRepo (.OwnForkRepo.AllowsPulls ctx)}}
						{{range .OwnForkRepoBranches}}
							<div class="item" data-url="{{$.OwnForkRepo.Link}}/compare/{{PathEscapeSegments .}}{{$.CompareSeparator}}{{PathEscape $.HeadUser.Name}}/{{PathEscape $.HeadRepo.Name}}:{{PathEscapeSegments $.HeadBranch}}">{{$OwnForkCompareName}}:{{.}}</div>
						{{end}}
					{{end}}
					{{if and .RootRepo (.RootRepo.AllowsPulls ctx)}}
						{{range .RootRepoBranches}}
							<div class="item" data-url="{{$.RootRepo.Link}}/compare/{{PathEscapeSegments .}}{{$.CompareSeparator}}{{PathEscape $.HeadUser.Name}}/{{PathEscape $.HeadRepo.Name}}:{{PathEscapeSegments $.HeadBranch}}">{{$RootRepoCompareName}}:{{.}}</div>
						{{end}}
					{{end}}
				</div>
				<div class="scrolling menu reference-list-menu base-tag-list tw-hidden">
					{{range .Tags}}
						<div class="item {{if eq $.BaseBranch .}}selected{{end}}" data-url="{{$.RepoLink}}/compare/{{PathEscapeSegments .}}{{$.CompareSeparator}}{{if not $.PullRequestCtx.SameRepo}}{{PathEscape $.HeadUser.Name}}/{{PathEscape $.HeadRepo.Name}}:{{end}}{{PathEscapeSegments $.HeadBranch}}">{{if not $.PullRequestCtx.SameRepo}}{{$BaseCompareName}}:{{end}}{{.}}</div>
					{{end}}
					{{if and (not .PullRequestCtx.SameRepo) ($.HeadRepo.AllowsPulls ctx)}}
						{{range .HeadTags}}
							<div class="item" data-url="{{$.HeadRepo.Link}}/compare/{{PathEscapeSegments .}}{{$.CompareSeparator}}{{PathEscape $.HeadUser.Name}}/{{PathEscape $.HeadRepo.Name}}:{{PathEscapeSegments $.HeadBranch}}">{{if not $.PullRequestCtx.SameRepo}}{{$HeadCompareName}}:{{end}}{{.}}</div>
						{{end}}
					{{end}}
					{{if and .OwnForkRepo (.OwnForkRepo.AllowsPulls ctx)}}
						{{range .OwnForkRepoTags}}
							<div class="item" data-url="{{$.OwnForkRepo.Link}}/compare/{{PathEscapeSegments .}}{{$.CompareSeparator}}{{PathEscape $.HeadUser.Name}}/{{PathEscape $.HeadRepo.Name}}:{{PathEscapeSegments $.HeadBranch}}">{{$OwnForkCompareName}}:{{.}}</div>
						{{end}}
					{{end}}
					{{if and .RootRepo (.RootRepo.AllowsPulls ctx)}}
						{{range .RootRepoTags}}
							<div class="item" data-url="{{$.RootRepo.Link}}/compare/{{PathEscapeSegments .}}{{$.CompareSeparator}}{{PathEscape $.HeadUser.Name}}/{{PathEscape $.HeadRepo.Name}}:{{PathEscapeSegments $.HeadBranch}}">{{$RootRepoCompareName}}:{{.}}</div>
						{{end}}
					{{end}}
				</div>
			</div>
		</div>
		<a href="{{.RepoLink}}/compare/{{PathEscapeSegments .BaseBranch}}{{.OtherCompareSeparator}}{{if not $.PullRequestCtx.SameRepo}}{{PathEscape $.HeadUser.Name}}/{{PathEscape $.HeadRepo.Name}}:{{end}}{{PathEscapeSegments $.HeadBranch}}" title="{{ctx.Locale.Tr "repo.pulls.switch_comparison_type"}}">{{svg "octicon-arrow-left" 16}}<div class="compare-separator">{{.CompareSeparator}}</div></a>
		<div class="ui floating filter dropdown">
			<div class="ui basic small button">
				<span class="text"><span class="compare-ref-label">{{ctx.Locale.Tr "repo.compare.compare_head"}}:</span> {{if not $.PullRequestCtx.SameRepo}}{{$HeadCompareName}}:{{end}}{{$.HeadBranch}}</span>
				{{svg "octicon-triangle-down" 14 "dropdown icon"}}
			</div>
			<div class="menu">
				<div class="ui icon search input">
					<i class="icon">{{svg "octicon-filter" 16}}</i>
					<input name="search" placeholder="{{ctx.Locale.Tr "repo.filter_branch_and_tag"}}...">
				</div>
				<div class="branch-tag-tab">
					<a class="branch-tag-item muted" href="#" data-target=".head-branch-list">
						{{svg "octicon-git-branch"}}{{ctx.Locale.Tr "repo.branches"}}
					</a>
					<a class="branch-tag-item muted" href="#" data-target=".head-tag-list">
						{{svg "octicon-tag"}}{{ctx.Locale.Tr "repo.tags"}}
					</a>
				</div>
				<div class="scrolling menu reference-list-menu head-branch-list">
					{{range .HeadBranches}}
						<div class="{{if eq $.HeadBranch .}}selected{{end}} item" data-url="{{$.RepoLink}}/compare/{{PathEscapeSegments $.BaseBranch}}{{$.CompareSeparator}}{{if not $.PullRequestCtx.SameRepo}}{{PathEscape $.HeadUser.Name}}/{{PathEscape $.HeadRepo.Name}}:{{end}}{{PathEscapeSegments .}}">{{if not $.PullRequestCtx.SameRepo}}{{$HeadCompareName}}:{{end}}{{.}}</div>
					{{end}}
					{{if not .PullRequestCtx.SameRepo}}
						{{range .Branches}}
							<div class="item" data-url="{{$.RepoLink}}/compare/{{PathEscapeSegments $.BaseBranch}}{{$.CompareSeparator}}{{PathEscape $.BaseName}}/{{PathEscape $.Repository.Name}}:{{PathEscapeSegments .}}">{{if not $.PullRequestCtx.SameRepo}}{{$BaseCompareName}}:{{end}}{{.}}</div>
						{{end}}
					{{end}}
					{{if .OwnForkRepo}}
						{{range .OwnForkRepoBranches}}
							<div class="item" data-url="{{$.RepoLink}}/compare/{{PathEscapeSegments $.BaseBranch}}{{$.CompareSeparator}}{{PathEscape $.OwnForkRepo.OwnerName}}/{{PathEscape $.OwnForkRepo.Name}}:{{PathEscapeSegments .}}">{{$OwnForkCompareName}}:{{.}}</div>
						{{end}}
					{{end}}
					{{if .RootRepo}}
						{{range .RootRepoBranches}}
							<div class="item" data-url="{{$.RepoLink}}/compare/{{PathEscapeSegments $.BaseBranch}}{{$.CompareSeparator}}{{PathEscape $.RootRepo.OwnerName}}/{{PathEscape $.RootRepo.Name}}:{{PathEscapeSegments .}}">{{$RootRepoCompareName}}:{{.}}</div>
						{{end}}
					{{end}}
				</div>
				<div class="scrolling menu reference-list-menu head-tag-list tw-hidden">
					{{range .HeadTags}}
						<div class="{{if eq $.HeadBranch .}}selected{{end}} item" data-url="{{$.RepoLink}}/compare/{{PathEscapeSegments $.BaseBranch}}{{$.CompareSeparator}}{{if not $.PullRequestCtx.SameRepo}}{{PathEscape $.HeadUser.Name}}/{{PathEscape $.HeadRepo.Name}}:{{end}}{{PathEscapeSegments .}}">{{if not $.PullRequestCtx.SameRepo}}{{$HeadCompareName}}:{{end}}{{.}}</div>
					{{end}}
					{{if not .PullRequestCtx.SameRepo}}
						{{range .Tags}}
							<div class="item" data-url="{{$.RepoLink}}/compare/{{PathEscapeSegments $.BaseBranch}}{{$.CompareSeparator}}{{PathEscape $.BaseName}}/{{PathEscape $.Repository.Name}}:{{PathEscapeSegments .}}">{{if not $.PullRequestCtx.SameRepo}}{{$BaseCompareName}}:{{end}}{{.}}</div>
						{{end}}
					{{end}}
					{{if .OwnForkRepo}}
						{{range .OwnForkRepoTags}}
							<div class="item" data-url="{{$.RepoLink}}/compare/{{PathEscapeSegments $.BaseBranch}}{{$.CompareSeparator}}{{PathEscape $.OwnForkRepo.OwnerName}}/{{PathEscape $.OwnForkRepo.Name}}:{{PathEscapeSegments .}}">{{$OwnForkCompareName}}:{{.}}</div>
						{{end}}
					{{end}}
					{{if .RootRepo}}
						{{range .RootRepoTags}}
							<div class="item" data-url="{{$.RepoLink}}/compare/{{PathEscapeSegments $.BaseBranch}}{{$.CompareSeparator}}{{PathEscape $.RootRepo.OwnerName}}/{{PathEscape $.RootRepo.Name}}:{{PathEscapeSegments .}}">{{$RootRepoCompareName}}:{{.}}</div>
						{{end}}
					{{end}}
				</div>
			</div>
		</div>
	</div>

	{{/* What a new pull request would merge, in Forgejo's words from the pull request header. */}}
	{{$headRef := $.HeadBranch}}{{if not $.PullRequestCtx.SameRepo}}{{$headRef = printf "%s:%s" $HeadCompareName $.HeadBranch}}{{end}}
	{{$baseRef := $.BaseBranch}}{{if not $.PullRequestCtx.SameRepo}}{{$baseRef = printf "%s:%s" $BaseCompareName $.BaseBranch}}{{end}}
	{{if .IsNothingToCompare}}
		{{if and $.IsSigned $.AllowEmptyPr (not .Repository.IsArchived) .PageIsComparePull}}
			<div class="ui info message show-form-container theme-compare-create {{if .Flash}}tw-hidden{{end}}">
				<span>{{ctx.Locale.Tr "repo.pulls.nothing_to_compare_and_allow_empty_pr"}}</span>
				<button class="ui button primary show-form">{{ctx.Locale.Tr "repo.pulls.create"}}</button>
			</div>
			<div class="pullrequest-form {{if not .Flash}}tw-hidden{{end}}">
				{{template "repo/issue/new_form" .}}
			</div>
		{{else}}
			{{/* GitHub's blank slate for a comparison without changes. */}}
			<div class="theme-empty theme-compare-empty">
				{{svg "octicon-git-compare" 32}}
				<h3>{{if and .HeadIsBranch .BaseIsBranch}}{{ctx.Locale.Tr "repo.commits.nothing_to_compare"}}{{else}}{{ctx.Locale.Tr "repo.pulls.nothing_to_compare_have_tag"}}{{end}}</h3>
			</div>
		{{end}}
	{{else if and .PageIsComparePull (gt .CommitCount 0) $canReadPullRequests}}
		{{if .HasPullRequest}}
			{{/* GitHub's row for the open pull request of these branches: its state icon, title, number and a button. */}}
			{{$pullLink := print $.RepoLink "/pulls/" .PullRequest.Issue.Index}}
			<div class="theme-compare-existing">
				<div class="theme-compare-existing-main">
					<h2>
						{{if .PullRequest.HasMerged}}
							{{svg "octicon-git-merge" 16 "theme-compare-existing-merged"}}
						{{else if .PullRequest.Issue.IsClosed}}
							{{svg "octicon-git-pull-request-closed" 16 "theme-compare-existing-closed"}}
						{{else}}
							{{svg "octicon-git-pull-request" 16 "theme-compare-existing-open"}}
						{{end}}
						<a id="issue-title" href="{{$pullLink}}">{{RenderIssueTitle $.Context .PullRequest.Issue.Title ($.Repository.ComposeMetas ctx)}}</a>
						<span class="index">#{{.PullRequest.Issue.Index}}</span>
					</h2>
					<p>{{ctx.Locale.Tr "repo.pulls.has_pull_request" $pullLink $.RepoRelPath .PullRequest.Index}}</p>
				</div>
				<a href="{{$pullLink}}" class="ui button primary show-form">{{svg "octicon-git-pull-request" 16}} {{ctx.Locale.Tr "repo.pulls.view"}}</a>
			</div>
		{{else}}
			{{if and $.IsSigned (not .Repository.IsArchived)}}
				<div class="ui info message show-form-container theme-compare-create {{if .Flash}}tw-hidden{{end}}">
					<span><strong>{{$.SignedUser.Name}}</strong> {{ctx.Locale.TrPluralString .CommitCount "repo.pulls.title_desc" .CommitCount $headRef $baseRef "theme-compare-base"}}</span>
					<button class="ui button primary show-form">{{ctx.Locale.Tr "repo.pulls.create"}}</button>
				</div>
			{{else if .Repository.IsArchived}}
				<div class="ui warning message tw-text-center">
					{{if .Repository.ArchivedUnix.IsZero}}
						{{ctx.Locale.Tr "repo.archive.title"}}
					{{else}}
						{{ctx.Locale.Tr "repo.archive.title_date" (DateUtils.AbsoluteLong .Repository.ArchivedUnix)}}
					{{end}}
				</div>
			{{else}}
				<div class="ui warning message tw-mb-4">
					{{ctx.Locale.Tr "repo.pulls.sign_in_require" .SignInLink}}
				</div>
			{{end}}
			{{if $.IsSigned}}
				<div class="pullrequest-form {{if not .Flash}}tw-hidden{{end}}">
					{{template "repo/issue/new_form" .}}
				</div>
			{{end}}
			{{$showDiffBox = true}}
		{{end}}
	{{else if not .IsNothingToCompare}}
		{{$showDiffBox = true}}
	{{end}}
	</div>

	{{if $showDiffBox}}
	<div class="ui container">
		{{if and .Commits (gt .CommitCount 0)}}
			{{/* GitHub's summary of commits, changed files and people over the commits grouped by day. */}}
			{{$authors := 0}}{{$seen := ""}}
			{{range .Commits}}
				{{$key := printf "<%s>" .Author.Email}}
				{{if not (StringUtils.Contains $seen $key)}}{{$seen = print $seen $key}}{{$authors = Eval $authors "+" 1}}{{end}}
			{{end}}
			<ul class="theme-compare-summary">
				<li>{{svg "octicon-git-commit" 16}}{{ctx.Locale.TrPluralString .CommitCount "counters.n_commits" (ctx.Locale.PrettyNumber .CommitCount)}}</li>
				{{if not .DiffNotAvailable}}<li>{{svg "octicon-file-diff" 16}}{{ctx.Locale.TrN .DiffMetadata.TotalNumberOfFiles "repo.activity.git_stats_file_1" "repo.activity.git_stats_file_n" .DiffMetadata.TotalNumberOfFiles}}</li>{{end}}
				<li>{{svg "octicon-people" 16}}{{ctx.Locale.TrN $authors "repo.activity.git_stats_author_1" "repo.activity.git_stats_author_n" $authors}}</li>
			</ul>
			{{template "repo/pulls/commits_list" .}}
		{{else}}
			{{template "repo/commits_table" .}}
		{{end}}
		{{template "repo/diff/box" .}}
	</div>
	{{end}}
</div>
{{template "base/footer" .}}
