<details class="theme-menu diff-view-settings">
	<summary class="theme-icon-button theme-icon-button-outlined" aria-label="{{ctx.Locale.Tr "repo.diff.options_button"}}">{{svg "octicon-gear" 16}}</summary>
	<div class="theme-menu-popover">
		<a href="?style=unified&amp;whitespace={{.WhitespaceBehavior}}&amp;show-outdated={{.ShowOutdatedComments}}"><input type="radio" tabindex="-1" {{if not .IsSplitStyle}}checked{{end}}>{{ctx.Locale.Tr "repo.diff.show_unified_view"}}</a>
		<a href="?style=split&amp;whitespace={{.WhitespaceBehavior}}&amp;show-outdated={{.ShowOutdatedComments}}"><input type="radio" tabindex="-1" {{if .IsSplitStyle}}checked{{end}}>{{ctx.Locale.Tr "repo.diff.show_split_view"}}</a>
		{{if .PageIsPullFiles}}<hr><label><input type="checkbox" id="diff-minimize-comments">Minimize comments</label>{{end}}
		<hr>
		{{/* GitHub has one "Hide whitespace" toggle; Forgejo's four whitespace modes stay a choice. */}}
		{{$style := "unified"}}{{if .IsSplitStyle}}{{$style = "split"}}{{end}}
		<span class="theme-menu-title">{{ctx.Locale.Tr "repo.diff.whitespace_button"}}</span>
		<a href="?style={{$style}}&amp;whitespace=show-all&amp;show-outdated={{.ShowOutdatedComments}}"><input type="radio" tabindex="-1" {{if eq .WhitespaceBehavior "show-all"}}checked{{end}}>{{ctx.Locale.Tr "repo.diff.whitespace_show_everything"}}</a>
		<a href="?style={{$style}}&amp;whitespace=ignore-all&amp;show-outdated={{.ShowOutdatedComments}}"><input type="radio" tabindex="-1" {{if eq .WhitespaceBehavior "ignore-all"}}checked{{end}}>{{ctx.Locale.Tr "repo.diff.whitespace_ignore_all_whitespace"}}</a>
		<a href="?style={{$style}}&amp;whitespace=ignore-change&amp;show-outdated={{.ShowOutdatedComments}}"><input type="radio" tabindex="-1" {{if eq .WhitespaceBehavior "ignore-change"}}checked{{end}}>{{ctx.Locale.Tr "repo.diff.whitespace_ignore_amount_changes"}}</a>
		<a href="?style={{$style}}&amp;whitespace=ignore-eol&amp;show-outdated={{.ShowOutdatedComments}}"><input type="radio" tabindex="-1" {{if eq .WhitespaceBehavior "ignore-eol"}}checked{{end}}>{{ctx.Locale.Tr "repo.diff.whitespace_ignore_at_eol"}}</a>
		<hr>
		<label><input type="checkbox" id="diff-compact-lines" checked>Compact line height</label>
		<hr>
		<button type="button" id="expand-files-btn">{{ctx.Locale.Tr "repo.pulls.expand_files"}}</button>
		<button type="button" id="collapse-files-btn">{{ctx.Locale.Tr "repo.pulls.collapse_files"}}</button>
        {{if .Issue.Index}}
            <hr>
            <a href="{{$.RepoLink}}/pulls/{{.Issue.Index}}.patch" download>{{ctx.Locale.Tr "repo.diff.download_patch"}}</a>
            <a href="{{$.RepoLink}}/pulls/{{.Issue.Index}}.diff" download>{{ctx.Locale.Tr "repo.diff.download_diff"}}</a>
            <a href="?style={{if .IsSplitStyle}}split{{else}}unified{{end}}&amp;whitespace={{.WhitespaceBehavior}}&amp;show-outdated={{if .ShowOutdatedComments}}false{{else}}true{{end}}">{{if .ShowOutdatedComments}}{{ctx.Locale.Tr "repo.issues.review.option.hide_outdated_comments"}}{{else}}{{ctx.Locale.Tr "repo.issues.review.option.show_outdated_comments"}}{{end}}</a>
        {{end}}
	</div>
</details>
