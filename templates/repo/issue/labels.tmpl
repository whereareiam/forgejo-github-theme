{{/* GitHub lists a repository's labels inside the issue sidebar layout: a heading with New label, then the label box. */}}
{{template "base/head" .}}
{{$canWrite := and (or .CanWriteIssues .CanWritePulls) (not .Repository.IsArchived)}}
<div role="main" aria-label="{{.Title}}" class="page-content repository labels theme-sidebar-layout" data-theme-sidebar="issue_sidebar_collapsed">
	{{template "repo/issue/sidebar" .}}
	<div class="ui container theme-sidebar-main">
		<section class="theme-box-list-page">
			<div class="theme-list-heading">
				<div class="theme-list-title"><button type="button" class="theme-icon-button" data-theme-sidebar-toggle data-theme-sidebar-expand aria-expanded="false" aria-label="{{ctx.Locale.Tr "toggle_menu"}}">{{svg "octicon-sidebar-expand" 16}}</button><h1>{{ctx.Locale.Tr "repo.labels"}}</h1></div>
				{{if $canWrite}}<button class="ui primary new-label button theme-control">{{ctx.Locale.Tr "repo.issues.new_label"}}</button>{{end}}
			</div>
			{{if $canWrite}}
				{{template "repo/issue/labels/label_new" .}}
			{{end}}
			{{template "base/alert" .}}
			{{template "repo/issue/labels/label_list" .}}
		</section>
	</div>
</div>
{{if $canWrite}}
	{{template "repo/issue/labels/edit_delete_label" .}}
{{end}}
{{template "base/footer" .}}
