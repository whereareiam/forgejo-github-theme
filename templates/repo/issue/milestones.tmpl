{{/* GitHub lists a repository's milestones inside the issue sidebar layout: a heading with New milestone, the search,
then the milestone box. */}}
{{template "base/head" .}}
{{$canWrite := and (or .CanWriteIssues .CanWritePulls) (not .Repository.IsArchived)}}
<div role="main" aria-label="{{.Title}}" class="page-content repository milestones theme-sidebar-layout" data-theme-sidebar="issue_sidebar_collapsed">
	{{template "repo/issue/sidebar" .}}
	<div class="ui container theme-sidebar-main">
		{{template "base/alert" .}}
		<section class="theme-box-list-page">
			<div class="theme-list-heading">
				<div class="theme-list-title"><button type="button" class="theme-icon-button" data-theme-sidebar-toggle data-theme-sidebar-expand aria-expanded="false" aria-label="{{ctx.Locale.Tr "toggle_menu"}}">{{svg "octicon-sidebar-expand" 16}}</button><h1>{{ctx.Locale.Tr "repo.milestones"}}</h1></div>
				{{if $canWrite}}<a class="primary button theme-control" href="{{$.Link}}/new">{{ctx.Locale.Tr "repo.milestones.new"}}</a>{{end}}
			</div>
			<div class="theme-box-list-toolbar">
				<form class="ui form ignore-dirty theme-box-list-search" role="search">
					<input type="hidden" name="state" value="{{.State}}">
					<input type="hidden" name="sort" value="{{.SortType}}">
					{{template "components/common/search/search" dict "Kind" "icon" "Value" .Keyword "Placeholder" (ctx.Locale.Tr "search.milestone_kind") "Label" (ctx.Locale.Tr "search.milestone_kind")}}
				</form>
			</div>
			{{template "components/repository/milestone/list" dict "Data" . "Query" (print "?q=" (QueryEscape .Keyword)) "OpenCount" .OpenCount "ClosedCount" .ClosedCount "RepoLink" .RepoLink "CanWrite" $canWrite}}
		</section>
	</div>
</div>
{{if $canWrite}}
	<div class="ui g-modal-confirm delete modal" id="delete-milestone">
		<div class="header">
			{{svg "octicon-trash"}}
			{{ctx.Locale.Tr "repo.milestones.deletion"}}
		</div>
		<div class="content">
			<p>{{ctx.Locale.Tr "repo.milestones.deletion_desc"}}</p>
		</div>
		{{template "base/modal_actions_confirm" .}}
	</div>
{{end}}
{{template "base/footer" .}}
