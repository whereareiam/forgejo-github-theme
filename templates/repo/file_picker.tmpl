<div class="repo-file-picker" data-empty="{{ctx.Locale.Tr "repo.find_file.no_matching"}}" data-loading="{{ctx.Locale.Tr "loading"}}" data-error="{{ctx.Locale.Tr "error.network_error"}}" data-tree-url="{{.RepoLink}}/tree-list/{{.BranchNameSubURL}}" data-source-url="{{.RepoLink}}/src/{{.BranchNameSubURL}}">
                <label class="diff-search-field repo-find-file">
                    {{svg "octicon-search" 16}}
                    <input id="repo-go-to-file" type="text" role="combobox" aria-label="{{ctx.Locale.Tr "repo.find_file.go_to_file"}}" placeholder="{{ctx.Locale.Tr "repo.find_file.go_to_file"}}" autocomplete="off" aria-autocomplete="list" aria-expanded="false" aria-controls="repo-file-picker-results">
                    <kbd aria-hidden="true">T</kbd><button type="button" class="btn repo-picker-clear" aria-label="{{ctx.Locale.Tr "repo.milestones.clear"}}" hidden>{{svg "octicon-x-circle-fill" 16}}</button>
                </label>
                <template id="repo-picker-file-icon">{{svg "octicon-file" 16}}</template>
                <template id="repo-picker-directory-icon">{{svg "octicon-file-directory-fill" 16}}</template>
                <div id="repo-file-picker-results" class="repo-file-picker-results theme-menu-popover" role="listbox" aria-label="{{ctx.Locale.Tr "repo.find_file.go_to_file"}}" hidden></div>
                <div class="repo-file-picker-status" role="status" aria-live="polite"></div>
                <noscript><a href="{{.Repository.Link}}/find/{{.BranchNameSubURL}}">{{ctx.Locale.Tr "repo.find_file.go_to_file"}}</a></noscript>
            </div>
