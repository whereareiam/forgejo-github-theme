{{/* Repository home composition adapted to Forgejo 15 partials. */}}
{{/* The file tree's full list, fetched once per commit by repo-source-browser.js instead of sent with every page. */}}
{{if and .TreeNames (eq (.Context.Req.FormValue "source-tree") "list")}}
<template id="repo-source-tree-list">{{range .Context.Repo.Commit.ListEntriesRecursiveFast}}{{if not .IsDir}}{{.Name}}
{{end}}{{end}}</template>
{{else}}
{{template "base/head" .}}
{{$showSidebar := and (not .TreeNames) (not .HideRepoInfo) (not .IsBlame)}}
{{/* Layout classes instead of CSS :has(): a :has() on .page-content restyles the whole page, every line of a large file included, on any DOM change. */}}
<div role="main" aria-label="{{.Title}}" class="page-content repository file list {{if .IsBlame}}blame{{end}}{{if $showSidebar}} repo-has-sidebar{{else if .TreeNames}} repo-has-source-browser{{end}}">
	{{if not .TreeNames}}{{template "repo/home_header" .}}{{end}}
	<div class="ui container {{if or .TreeNames .IsBlame}}fluid padded{{end}}">
		{{template "base/alert" .}}

		{{if RepoFlagsEnabled}}
			{{template "custom/repo_flag_banners" .}}
			{{if .SignedUser.IsAdmin}}
				{{template "repo/admin_flags" .}}
			{{end}}
		{{end}}

		{{if .Repository.IsArchived}}
			<div class="ui warning message tw-text-center">
				{{if .Repository.ArchivedUnix.IsZero}}
					{{ctx.Locale.Tr "repo.archive.title"}}
				{{else}}
					{{ctx.Locale.Tr "repo.archive.title_date" (DateUtils.AbsoluteLong .Repository.ArchivedUnix)}}
				{{end}}
			</div>
		{{end}}

		{{if not .Repository.IsArchived}}
			{{template "repo/code/recently_pushed_new_branches" .}}
			{{template "repo/code/fork_sync_message" .}}
		{{end}}

		<div {{if .TreeNames}}id="repo-source-browser"{{end}} class="{{if $showSidebar}}repo-grid-filelist-sidebar{{else if .TreeNames}}repo-source-browser{{else}}repo-grid-filelist-only{{end}}">
            {{if .TreeNames}}
                {{template "repo/source_tree" .}}
                <div class="resizable-divider not-mobile" role="separator" aria-label="Resize file tree" aria-orientation="vertical" aria-valuemin="200" aria-valuenow="320" aria-valuemax="480" data-resize-container="#repo-source-browser" data-resize-content-minimum-width="320" data-resize-default-width="320" data-resize-maximum-width="480" data-resize-minimum-width="200" data-resize-storage-key="repo_file_tree_width" data-resize-variable="--repo-file-tree-width" tabindex="0"></div>
            {{end}}
			<div class="repo-home-filelist{{if .TreeNames}} repo-source-main{{end}}">
				{{template "repo/view_content" .}}
			</div>
			{{if $showSidebar}}
				{{template "repo/home_sidebar_top" .}}
				{{template "repo/home_sidebar_bottom" .}}
			{{end}}
		</div>
	</div>
</div>
{{template "base/footer" .}}
{{end}}
