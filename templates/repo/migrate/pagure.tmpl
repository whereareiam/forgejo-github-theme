{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository new migrate">
	<div class="ui middle very relaxed page grid">
		<div class="column">
			<form class="ui form" action="{{.Link}}" method="post">
				{{template "base/disable_form_autofill"}}
				{{template "components/common/form/header" dict "Title" (ctx.Locale.Tr "repo.migrate.migrate" .service.Title) "Lead" (ctx.Locale.Tr (printf "migrate.%s.description" .service.Name))}}
				<input id="service_type" type="hidden" name="service" value="{{.service}}">
				<div class="ui attached segment">
					{{template "base/alert" .}}
					<div class="inline required field {{if .Err_CloneAddr}}error{{end}}">
						<label for="clone_addr">{{ctx.Locale.Tr "migrate.pagure.project_url"}}</label>
						<input id="clone_addr" name="clone_addr" value="{{.clone_addr}}" autofocus required autocomplete="url">
						<span class="help">
							{{ctx.Locale.Tr "migrate.pagure.project_example"}}
							{{if .Err_CloneAddr}}
								{{ctx.Locale.Tr "migrate.pagure.incorrect_url"}}
							{{end}}
						</span>
					</div>
					{{template "repo/migrate/options" .}}
					<div id="migrate_items">
						<div class="inline field">
							<label>{{ctx.Locale.Tr "migrate.items.label"}}</label>
							<div class="ui checkbox">
								<input name="issues" type="checkbox" {{if .issues}}checked{{end}}>
								<label>{{ctx.Locale.Tr "migrate.items.issues"}}</label>
							</div>
						</div>
						<div class="inline field">
							<label></label>
							<div class="ui checkbox">
								<input name="pull_requests" type="checkbox" {{if .pull_requests}}checked{{end}}>
								<label>{{ctx.Locale.Tr "migrate.items.pull_requests"}}</label>
							</div>
						</div>
						<div class="inline field">
							<label></label>
							<div class="ui checkbox">
								<input name="labels" type="checkbox" {{if .labels}}checked{{end}}>
								<label>{{ctx.Locale.Tr "migrate.items.labels"}}</label>
							</div>
						</div>
						<div class="inline field">
							<label></label>
							<div class="ui checkbox">
								<input name="milestones" type="checkbox" {{if .milestones}}checked{{end}}>
								<label>{{ctx.Locale.Tr "migrate.items.milestones"}}</label>
							</div>
						</div>
					</div>
					<div class="divider"></div>
					{{template "components/repository/create/owner" dict "Owner" .ContextUser "Personal" .SignedUser "Orgs" .Orgs "Name" .repo_name "ErrOwner" .Err_Owner "ErrName" .Err_RepoName}}
					<div class="divider"></div>
					{{template "components/repository/create/visibility" dict "Private" .private "Forced" .IsForcedPrivate}}
					<div class="divider"></div>
					<details class="ui optional field">
						<summary class="tw-p-1">
							{{ctx.Locale.Tr "migrate.pagure.private_issues.summary"}}
						</summary>
						<div class="tw-p-1">
							<div class="ui blue message">
								{{ctx.Locale.Tr "migrate.pagure.private_issues.description"}}
							</div>
							<div class="ui red message">
								{{ctx.Locale.Tr "migrate.pagure.private_issues.warning"}}
							</div>
							<div class="field {{if .Err_Auth}}error{{end}}">
								<label for="auth_token">{{ctx.Locale.Tr "migrate.pagure.token_label"}}</label>
								<input id="auth_token" name="auth_token" value="{{.auth_token}}" placeholder="{{ctx.Locale.Tr "migrate.pagure.token.placeholder"}}" {{if not .auth_token}}data-need-clear="true"{{end}}>
							</div>
						</div>
					</details>
					<div class="divider"></div>
					<div class="theme-create-footer">
						<button class="ui primary button">
							{{ctx.Locale.Tr "repo.migrate_repo"}}
						</button>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>
{{template "base/footer" .}}
