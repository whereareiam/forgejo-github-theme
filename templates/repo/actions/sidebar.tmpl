{{/* GitHub's Actions sidebar: All workflows, then the repository's workflows, with Runners at the bottom for
	administrators. Forgejo has no string for the "Workflows" group: the theme's phrase names it, and without the wording
	add-on a rule sets the workflows apart. */}}
<aside class="theme-sidebar" aria-label="{{ctx.Locale.Tr "actions.actions"}}">
	<div class="theme-sidebar-content">
		<nav aria-label="{{ctx.Locale.Tr "actions.runs.workflow"}}">
			<a class="{{if not $.CurWorkflow}}active{{end}}" href="?actor={{$.CurActor}}&status={{$.CurStatus}}">{{svg "octicon-home" 16}}<span>{{ctx.Locale.Tr "actions.runs.all_workflows"}}</span></a>
			<hr>
			<span class="theme-sidebar-label">{{template "theme/phrase" dict "Key" "actions.sidebar.workflows" "Fallback" ""}}</span>
			{{range .workflows}}
				<a class="{{if eq .Entry.Name $.CurWorkflow}}active{{end}}" href="?workflow={{.Entry.Name}}&actor={{$.CurActor}}&status={{$.CurStatus}}">
					<span>{{.Entry.Name}}</span>
					{{if .ErrMsg}}<span class="actions-workflow-error" data-tooltip-content="{{.ErrMsg}}">{{svg "octicon-alert" 16}}</span>{{end}}
					{{if $.ActionsConfig.IsWorkflowDisabled .Entry.Name}}<span class="theme-counter">{{ctx.Locale.Tr "disabled"}}</span>{{end}}
				</a>
			{{end}}
		</nav>
		{{if .Permission.IsAdmin}}
			<nav class="theme-sidebar-footer" aria-label="{{ctx.Locale.Tr "actions.actions"}}">
				<a href="{{.RepoLink}}/settings/actions/runners">{{svg "octicon-server" 16}}<span>{{ctx.Locale.Tr "actions.runners"}}</span></a>
			</nav>
		{{end}}
	</div>
	{{template "components/common/sidebar/toggle" .}}
</aside>
