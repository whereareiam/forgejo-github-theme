{{/* GitHub-style commit list adapted to Forgejo 15 template data. */}}
<div class="ui attached table segment commit-table">
	<ul class="gitea-github-theme-templates-commits-list">
		{{$commitRepoLink := $.RepoLink}}{{if $.CommitRepoLink}}{{$commitRepoLink = $.CommitRepoLink}}{{end}}
		{{range $commit := $.Commits}}
			{{$commitID := $commit.ID.String}}
			<li class="gitea-github-theme-commit">
				<div class="message">
					{{if $.PageIsWiki}}
						<span class="commit-summary {{if gt $commit.ParentCount 1}}grey text{{end}}" title="{{$commit.Summary}}">{{$commit.Summary | RenderEmoji $.Context}}</span>
					{{else}}
						{{$commitLink := printf "%s/commit/%s" $commitRepoLink (PathEscape $commitID)}}
						{{if $.PageIsPullCommits}}
							{{$commitLink = printf "%s/pulls/%d/commits/%s" $commitRepoLink $.Issue.Index (PathEscape $commitID)}}
						{{end}}
						<span class="commit-summary {{if gt $commit.ParentCount 1}}grey text{{end}}" title="{{$commit.Summary}}">
							{{template "repo/commit_message_subject" dict
								"Context" $.Context
								"Message" $commit.Message
								"Summary" $commit.Summary
								"CommitLink" $commitLink
								"Metas" ($.Repository.ComposeMetas ctx)
							}}
						</span>
					{{end}}
					{{if IsMultilineCommitMessage $commit.Message}}
						<button class="ui button js-toggle-commit-body ellipsis-button" aria-expanded="false">...</button>
						<pre class="commit-body tw-hidden">{{RenderCommitBody $.Context $commit.Message ($.Repository.ComposeMetas ctx)}}</pre>
					{{end}}
				</div>
				<div class="metadata">
					{{$userName := $commit.Author.Name}}
					{{if $commit.User}}
						{{if and $commit.User.FullName DefaultShowFullName}}
							{{$userName = $commit.User.FullName}}
						{{end}}
						{{ctx.AvatarUtils.Avatar $commit.User 20}}
						<a class="muted author-wrapper" href="{{$commit.User.HomeLink}}">{{$userName}}</a>
					{{else}}
						{{ctx.AvatarUtils.AvatarByEmail $commit.Author.Email $commit.Author.Name 20}}
						<span class="author-wrapper">{{$userName}}</span>
					{{end}}
					{{if $commit.Committer}}
						{{DateUtils.TimeSince $commit.Committer.When}}
					{{else}}
						{{DateUtils.TimeSince $commit.Author.When}}
					{{end}}
					{{template "repo/commit_statuses" dict "Status" $commit.Status "Statuses" $commit.Statuses}}
				</div>
				<div class="extra">
					{{if $.CommitTagsMap}}
						{{range (index $.CommitTagsMap $commitID)}}
							{{- template "repo/tag/name" dict "AdditionalClasses" "gitea-github-theme-tag" "RepoLink" $.Repository.Link "TagName" .TagName "IsRelease" (not .IsTag) -}}
						{{end}}
					{{end}}
					{{$commitBaseLink := ""}}
					{{if $.PageIsWiki}}
						{{$commitBaseLink = printf "%s/wiki/commit" $commitRepoLink}}
					{{else if $.PageIsPullCommits}}
						{{$commitBaseLink = printf "%s/pulls/%d/commits" $commitRepoLink $.Issue.Index}}
					{{else}}
						{{$commitBaseLink = printf "%s/commit" $commitRepoLink}}
					{{end}}
					{{template "repo/commit_sign_badge" dict "Commit" $commit "CommitBaseLink" $commitBaseLink "CommitSignVerification" $commit.Verification}}
				</div>
				<div class="actions">
					<button class="btn interact-bg copy-commit-id gitea-github-theme-action" data-tooltip-content="{{ctx.Locale.Tr "copy_hash"}}" data-clipboard-text="{{$commitID}}">{{svg "octicon-copy"}}</button>
					{{if not $.PageIsWiki}}
						{{if $.FileName}}
						<a class="btn interact-bg view-single-diff gitea-github-theme-action" data-tooltip-content="{{ctx.Locale.Tr "repo.commits.view_single_diff"}}"
							href="{{$commitRepoLink}}/commit/{{PathEscape $commitID}}?files={{PathEscapeSegments $.FileName}}"
						>{{svg "octicon-file-diff"}}</a>
						{{end}}
						<a class="btn interact-bg view-commit-path gitea-github-theme-action" data-tooltip-content="{{ctx.Locale.Tr "repo.commits.view_path"}}"
							href="{{if $.FileName}}{{printf "%s/src/commit/%s/%s" $commitRepoLink (PathEscape $commitID) (PathEscapeSegments $.FileName)}}{{else}}{{printf "%s/src/commit/%s" $commitRepoLink (PathEscape $commitID)}}{{end}}"
						>{{svg "octicon-file-code"}}</a>
					{{end}}
				</div>
			</li>
		{{end}}
	</ul>
</div>
