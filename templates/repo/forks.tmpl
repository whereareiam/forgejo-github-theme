{{/* GitHub's forks page: a heading over a box with a row per fork (its owner's avatar, owner and name), or GitHub's
empty state. Forgejo has no sentence for that state, so it shows Forgejo's fork count, zero. */}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository forks">
	<div class="ui container">
		<section class="theme-box-list-page">
			<div class="theme-list-heading"><div class="theme-list-title"><h1>{{ctx.Locale.Tr "repo.forks"}}</h1></div></div>
			{{if .Forks}}
				<div class="theme-box-list">
					<ul class="theme-box-list-rows">
						{{range .Forks}}
							<li class="theme-box-list-row theme-fork-row">
								{{ctx.AvatarUtils.Avatar .Owner 20}}
								<div class="theme-box-list-main">
									<h3><a href="{{.Owner.HomeLink}}">{{.Owner.Name}}</a> / <a href="{{.Link}}">{{.Name}}</a></h3>
								</div>
							</li>
						{{end}}
					</ul>
				</div>
			{{else}}
				<div class="theme-empty">
					{{svg "octicon-repo-forked" 24}}
					<h3>{{ctx.Locale.TrPluralString 0 "fork.n_forks" "0"}}</h3>
				</div>
			{{end}}
		</section>
		{{template "base/paginate" .}}
	</div>
</div>
{{template "base/footer" .}}
