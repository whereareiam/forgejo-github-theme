{{/* GitHub's repository settings nav: an icon per page in groups. Forgejo has strings only for Security, so the
	other groups are set apart by a separator instead of an English name. */}}
<div class="flex-container-nav">
	<div class="ui fluid vertical menu theme-nav-list">
		<a class="{{if .PageIsSettingsOptions}}active {{end}}item" href="{{.RepoLink}}/settings">
			{{svg "octicon-gear" 16}}{{ctx.Locale.Tr "repo.settings.options"}}
		</a>
		<details class="item toggleable-item" {{if .PageIsRepoSettingsUnits}}open{{end}}>
			<summary {{if .PageIsRepoSettingsUnits}}class="active"{{end}}>{{svg "octicon-apps" 16}}{{ctx.Locale.Tr "repo.settings.units.units"}}</summary>
			<div class="menu">
				<a class="item" href="{{.RepoLink}}/settings/units">
					{{ctx.Locale.Tr "repo.settings.units.overview"}}
				</a>
				<a class="item" href="{{.RepoLink}}/settings/units#issues">
					{{ctx.Locale.Tr "repo.issues"}}
				</a>
				<a class="item" href="{{.RepoLink}}/settings/units#pulls">
					{{ctx.Locale.Tr "repo.pulls"}}
				</a>
				<a class="item" href="{{.RepoLink}}/settings/units#wiki">
					{{ctx.Locale.Tr "repo.wiki"}}
				</a>
			</div>
		</details>
		<div class="theme-settings-separator" role="separator"></div>
		<a class="{{if .PageIsSettingsCollaboration}}active {{end}}item" href="{{.RepoLink}}/settings/collaboration">
			{{svg "octicon-people" 16}}{{ctx.Locale.Tr "repo.settings.collaboration"}}
		</a>
		<div class="theme-settings-separator" role="separator"></div>
		{{if .Repository.UnitEnabled $.Context $.UnitTypeCode}}
			{{if not .Repository.IsEmpty}}
				<a class="{{if .PageIsSettingsBranches}}active {{end}}item" href="{{.RepoLink}}/settings/branches">
					{{svg "octicon-git-branch" 16}}{{ctx.Locale.Tr "repo.settings.branches"}}
				</a>
			{{end}}
			<a class="{{if .PageIsSettingsTags}}active {{end}}item" href="{{.RepoLink}}/settings/tags">
				{{svg "octicon-tag" 16}}{{ctx.Locale.Tr "repo.settings.tags"}}
			</a>
		{{end}}
		{{if and .EnableActions (not .UnitActionsGlobalDisabled) (.Permission.CanRead $.UnitTypeActions)}}
		<details class="item toggleable-item" {{if or .PageIsSharedSettingsRunners .PageIsSharedSettingsSecrets .PageIsSharedSettingsVariables}}open{{end}}>
			<summary>{{svg "octicon-play" 16}}{{ctx.Locale.Tr "actions.actions"}}</summary>
			<div class="menu">
				<a class="{{if .PageIsSharedSettingsRunners}}active {{end}}item" href="{{.RepoLink}}/settings/actions/runners">
					{{ctx.Locale.Tr "actions.runners"}}
				</a>
				<a class="{{if .PageIsSharedSettingsSecrets}}active {{end}}item" href="{{.RepoLink}}/settings/actions/secrets">
					{{ctx.Locale.Tr "secrets.secrets"}}
				</a>
				<a class="{{if .PageIsSharedSettingsVariables}}active {{end}}item" href="{{.RepoLink}}/settings/actions/variables">
					{{ctx.Locale.Tr "actions.variables"}}
				</a>
			</div>
		</details>
		{{end}}
		{{if not DisableWebhooks}}
			<a class="{{if .PageIsSettingsHooks}}active {{end}}item" href="{{.RepoLink}}/settings/hooks">
				{{svg "octicon-webhook" 16}}{{ctx.Locale.Tr "repo.settings.hooks"}}
			</a>
		{{end}}
		{{if .Repository.UnitEnabled $.Context $.UnitTypeCode}}
			{{if .SignedUser.CanEditGitHook}}
				<a class="{{if .PageIsSettingsGitHooks}}active {{end}}item" href="{{.RepoLink}}/settings/hooks/git">
					{{svg "octicon-file-code" 16}}{{ctx.Locale.Tr "repo.settings.githooks"}}
				</a>
			{{end}}
			{{if .LFSStartServer}}
				<details class="item toggleable-item" {{if .PageIsSettingsLFS}}open{{end}}>
					<summary {{if .PageIsSettingsLFS}}class="active"{{end}}>{{svg "octicon-file-binary" 16}}{{ctx.Locale.Tr "repo.settings.lfs"}}</summary>
					<div class="menu">
						<a class="item" href="{{.RepoLink}}/settings/lfs">
							{{ctx.Locale.Tr "repo.settings.units.overview"}}
						</a>
						<a class="item" href="{{.RepoLink}}/settings/lfs/locks">
							{{ctx.Locale.Tr "repo.settings.lfs_locks"}}
						</a>
						<a class="item" href="{{.RepoLink}}/settings/lfs/pointers">
							{{ctx.Locale.Tr "repo.settings.lfs_findpointerfiles"}}
						</a>
					</div>
				</details>
			{{end}}
			<div class="theme-settings-group">{{ctx.Locale.Tr "settings.security"}}</div>
			<a class="{{if .PageIsSettingsKeys}}active {{end}}item" href="{{.RepoLink}}/settings/keys">
				{{svg "octicon-key" 16}}{{ctx.Locale.Tr "repo.settings.deploy_keys"}}
			</a>
		{{end}}
	</div>
</div>
