{{/* GitHub's wiki pages index: the Pages heading with New page, then a box with a row per page and when it was last
updated. Forgejo's link to the page's Git file stays beside its name. */}}
{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository wiki pages">
	{{template "repo/header" .}}
	<div class="ui container theme-wiki">
		<div class="theme-wiki-header">
			<h1 class="theme-wiki-title">{{ctx.Locale.Tr "repo.wiki.pages"}}</h1>
			{{if and .CanWriteWiki (not .Repository.IsMirror)}}
				<div class="theme-wiki-actions">
					<a class="ui small primary button" href="{{.RepoLink}}/wiki?action=_new">{{ctx.Locale.Tr "repo.wiki.new_page_button"}}</a>
				</div>
			{{end}}
		</div>
		<ul class="theme-wiki-index wiki-pages-list">
			{{range .Pages}}
				<li>
					{{svg "octicon-file" 16 "theme-wiki-index-icon"}}
					<div class="theme-wiki-index-main">
						<span class="theme-wiki-index-name">
							<a href="{{$.RepoLink}}/wiki/{{.SubURL}}">{{.Name}}</a>
							<a class="wiki-git-entry muted" href="{{$.RepoLink}}/wiki/{{.GitEntryName | PathEscape}}" data-tooltip-content="{{ctx.Locale.Tr "repo.wiki.original_git_entry_tooltip"}}" aria-label="{{ctx.Locale.Tr "repo.wiki.original_git_entry_tooltip"}}">{{svg "octicon-chevron-right"}}</a>
						</span>
						<span class="theme-wiki-index-updated">{{ctx.Locale.Tr "repo.wiki.last_updated" (DateUtils.TimeSince .UpdatedUnix)}}</span>
					</div>
				</li>
			{{end}}
		</ul>
	</div>
</div>
{{template "base/footer" .}}
