{{/*
	GitHub-style project board, shared by repository, organization and user projects. Forgejo's board script needs
	.project-column, .cards, .issue-card[data-issue], the .project-column-issue-count inside each column and the column
	modals inside .project-column-header, so those keep Forgejo's classes. Column colours become GitHub's status dot;
	columns without one named like GitHub's default statuses get GitHub's colour (see pages/projects.css).
*/}}
{{$canWriteProject := and .CanWriteProjects (or (not .Repository) (not .Repository.IsArchived))}}

<div class="github-project-header">
	<h1 class="github-project-title">
		{{if .Project.IsClosed}}{{svg "octicon-lock" 16}}{{end}}
		<span>{{.Project.Title}}</span>
	</h1>
	<div class="github-project-actions">
		{{if and .Repository (not .Repository.IsArchived)}}
			<a class="ui primary button theme-control" href="{{.RepoLink}}/issues/new/choose?project={{.Project.ID}}" data-project-panel-link>{{ctx.Locale.Tr "repo.issues.new"}}</a>
		{{else if and (not .Repository) .IsSigned (not .Project.IsClosed)}}
			{{/* Organization and user projects have no repository of their own: pick one of the owner's repositories,
				then Forgejo's new issue form opens with this project already set. The board script lists them. */}}
			<details class="theme-menu github-project-new-issue" data-owner-id="{{.ContextUser.ID}}" data-project-id="{{.Project.ID}}">
				<summary class="ui primary button theme-control" aria-haspopup="menu">
					{{ctx.Locale.Tr "repo.issues.new"}}
					{{svg "octicon-triangle-down" 16}}
				</summary>
				<div class="theme-menu-popover" role="menu">
					<span class="theme-menu-title">{{ctx.Locale.Tr "repository"}}</span>
					<div class="github-project-repo-filter">
						{{template "components/common/search/search" dict "Kind" "icon" "Local" true "ID" "project-repo-filter" "Placeholder" (ctx.Locale.Tr "search.repo_kind")}}
					</div>
					<p class="github-project-repo-status" role="status" data-empty="{{ctx.Locale.Tr "search.no_results"}}" data-error="{{ctx.Locale.Tr "error.network_error"}}">{{ctx.Locale.Tr "loading"}}</p>
				</div>
				<template class="github-project-repo-icon">{{svg "octicon-repo" 16}}</template>
			</details>
		{{end}}
		{{if $canWriteProject}}
			<div class="github-project-button-group">
				<a class="button theme-control" href="{{.Link}}/edit?redirect=project">
					{{svg "octicon-pencil"}}
					{{ctx.Locale.Tr "repo.issues.label_edit"}}
				</a>
				{{if .Project.IsClosed}}
					<button class="button theme-control link-action" data-url="{{.Link}}/open">
						{{svg "octicon-check"}}
						{{ctx.Locale.Tr "repo.projects.open"}}
					</button>
				{{else}}
					<button class="button theme-control link-action" data-url="{{.Link}}/close">
						{{svg "octicon-skip"}}
						{{ctx.Locale.Tr "repo.projects.close"}}
					</button>
				{{end}}
				<button class="button theme-control delete-button" data-url="{{.Link}}/delete" data-id="{{.Project.ID}}" data-modal-id="delete-project">
					{{svg "octicon-trash"}}
					{{ctx.Locale.Tr "repo.issues.label_delete"}}
				</button>
			</div>
		{{end}}
	</div>
</div>

{{if .Project.RenderedContent}}
	<div class="github-project-description markup">{{$.Project.RenderedContent}}</div>
{{end}}

<div class="github-project-filter">
	{{template "components/common/search/search" dict "Kind" "icon" "Local" true "ID" "project-board-filter" "Placeholder" (ctx.Locale.Tr "filter")}}
</div>

{{if $canWriteProject}}
	<dialog class="modal" id="new-project-column-item">
		<article>
			<header>{{ctx.Locale.Tr "repo.projects.column.new"}}</header>
			<form class="ui form">
				<div class="content">
					<div class="required field">
						<label for="new_project_column">{{ctx.Locale.Tr "repo.projects.column.new_title"}}</label>
						<input class="new-project-column" id="new_project_column" name="title" required>
					</div>

					<div class="field color-field">
						<label for="new_project_column_color_picker">{{ctx.Locale.Tr "repo.projects.column.color"}}</label>
						<div class="js-color-picker-input column">
							<input maxlength="7" placeholder="#c320f6" id="new_project_column_color_picker" name="color">
							{{template "repo/issue/label_precolors"}}
						</div>
					</div>
				</div>
				<div class="actions">
					<button type="button" class="ui cancel button">{{ctx.Locale.Tr "settings.cancel"}}</button>
					<button data-url="{{$.Link}}" class="ui primary button" id="new_project_column_submit">{{ctx.Locale.Tr "repo.projects.column.new_submit"}}</button>
				</div>
			</form>
		</article>
	</dialog>
{{end}}

<div id="project-board">
	<div class="board {{if $canWriteProject}}sortable{{end}}"{{if $canWriteProject}} data-url="{{$.Link}}/move"{{end}}>
		{{range .Columns}}
			<div class="project-column"{{if .Color}} style="--project-column-color: {{.Color}}"{{end}} data-column-title="{{.Title}}" data-id="{{.ID}}" data-sorting="{{.Sorting}}" data-url="{{$.Link}}/{{.ID}}">
				<div class="project-column-header{{if $canWriteProject}} tw-cursor-grab{{end}}">
					<span class="project-column-dot" aria-hidden="true"></span>
					<span class="project-column-title-label">{{.Title}}</span>
					<span class="theme-counter project-column-issue-count">{{len (index $.IssuesMap .ID)}}</span>
					{{if .Default}}<span class="project-column-default" data-tooltip-content="{{ctx.Locale.Tr "repo.projects.column.set_default"}}">{{svg "octicon-pin" 12}}</span>{{end}}
					{{if $canWriteProject}}
						<div class="ui dropdown jump item project-column-menu">
							<span class="theme-icon-button" aria-label="{{ctx.Locale.Tr "repo.projects.column.edit"}}">
								{{svg "octicon-kebab-horizontal"}}
							</span>
							<div class="menu user-menu">
								<a class="item show-modal button" data-modal="#edit-project-column-modal-{{.ID}}">
									{{svg "octicon-pencil"}}
									{{ctx.Locale.Tr "repo.projects.column.edit"}}
								</a>
								{{if not .Default}}
									<a class="item show-modal button default-project-column-show"
										data-modal="#default-project-column-modal-{{.ID}}"
										data-modal-default-project-column-header="{{ctx.Locale.Tr "repo.projects.column.set_default"}}"
										data-modal-default-project-column-content="{{ctx.Locale.Tr "repo.projects.column.set_default_desc"}}"
										data-url="{{$.Link}}/{{.ID}}/default">
										{{svg "octicon-pin"}}
										{{ctx.Locale.Tr "repo.projects.column.set_default"}}
									</a>
									<a class="item show-modal button show-delete-project-column-modal"
										data-modal="#delete-project-column-modal-{{.ID}}"
										data-url="{{$.Link}}/{{.ID}}">
										{{svg "octicon-trash"}}
										{{ctx.Locale.Tr "repo.projects.column.delete"}}
									</a>
								{{end}}

								<dialog class="modal edit-project-column-modal" id="edit-project-column-modal-{{.ID}}">
									<article>
										<header>{{ctx.Locale.Tr "repo.projects.column.edit"}}</header>
										<form class="ui form">
											<div class="content">
												<div class="required field">
													<label for="new_project_column_title">{{ctx.Locale.Tr "repo.projects.column.edit_title"}}</label>
													<input class="project-column-title-input" id="new_project_column_title" name="title" value="{{.Title}}" required>
												</div>

												<div class="field color-field">
													<label for="new_project_column_color">{{ctx.Locale.Tr "repo.projects.column.color"}}</label>
													<div class="js-color-picker-input column">
														<input maxlength="7" placeholder="#c320f6" id="new_project_column_color" name="color" value="{{.Color}}">
														{{template "repo/issue/label_precolors"}}
													</div>
												</div>

											</div>
											<div class="actions">
												<button type="button" class="ui cancel button">{{ctx.Locale.Tr "settings.cancel"}}</button>
												<button data-url="{{$.Link}}/{{.ID}}" class="ui primary button edit-project-column-button">{{ctx.Locale.Tr "repo.projects.column.edit"}}</button>
											</div>
										</form>
									</article>
								</dialog>

								<dialog class="modal default-project-column-modal" id="default-project-column-modal-{{.ID}}">
									<article>
										<header><span id="default-project-column-header"></span></header>
										<div class="content">
											<label id="default-project-column-content"></label>
										</div>
										{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm")}}
									</article>
								</dialog>

								<dialog class="modal" id="delete-project-column-modal-{{.ID}}">
									<article>
										<header>{{ctx.Locale.Tr "repo.projects.column.delete"}}</header>
										<div class="content">
											<label>
												{{ctx.Locale.Tr "repo.projects.column.deletion_desc"}}
											</label>
										</div>
										{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm")}}
									</article>
								</dialog>
							</div>
						</div>
					{{end}}
				</div>
				<div class="ui cards" data-url="{{$.Link}}/{{.ID}}" data-project="{{$.Project.ID}}" data-board="{{.ID}}" id="board_{{.ID}}">
					{{range (index $.IssuesMap .ID)}}
						<div class="issue-card tw-break-anywhere {{if $canWriteProject}}tw-cursor-grab{{end}}" data-issue="{{.ID}}">
							{{template "projects/card" (dict "Issue" . "Page" $)}}
						</div>
					{{end}}
				</div>
			</div>
		{{end}}
		{{if $canWriteProject}}
			<button type="button" class="github-project-add-column theme-icon-button theme-icon-button-outlined show-modal" data-modal="#new-project-column-item" aria-label="{{ctx.Locale.Tr "new_project_column"}}" data-tooltip-content="{{ctx.Locale.Tr "new_project_column"}}">
				{{svg "octicon-plus"}}
			</button>
		{{end}}
	</div>
</div>

{{/* GitHub opens a card's issue in a side panel. The panel shows the issue page itself, which the theme renders
	without the site chrome when it is loaded in this frame (see base/head_style). */}}
<div class="github-project-panel" data-project-id="{{.Project.ID}}" hidden>
	<div class="github-project-panel-backdrop" data-project-panel-close></div>
	<section class="github-project-panel-sheet" role="dialog" aria-modal="true" aria-label="{{ctx.Locale.Tr "repo.issues"}}">
		<div class="github-project-panel-toolbar">
			<a class="theme-icon-button github-project-panel-open" target="_blank" rel="noopener" aria-label="{{ctx.Locale.Tr "view"}}" data-tooltip-content="{{ctx.Locale.Tr "view"}}">{{svg "octicon-link-external"}}</a>
			<button type="button" class="theme-icon-button" data-project-panel-close aria-label="{{ctx.Locale.Tr "modal.close"}}">{{svg "octicon-x"}}</button>
		</div>
		{{/* Organization and user projects hold issues from several repositories, so their panel names the repository. */}}
		<iframe name="github-project-panel{{if not .Repository}}-owner{{end}}" title="{{ctx.Locale.Tr "repo.issues"}}"></iframe>
	</section>
</div>
<script src="{{AssetUrlPrefix}}/js/details-menu.js" defer></script>
<script src="{{AssetUrlPrefix}}/js/project-board.js" defer></script>

{{if $canWriteProject}}
	<div class="ui g-modal-confirm delete modal" id="delete-project">
		<div class="header">
			{{svg "octicon-trash"}}
			{{ctx.Locale.Tr "repo.projects.deletion"}}
		</div>
		<div class="content">
			<p>{{ctx.Locale.Tr "repo.projects.deletion_desc"}}</p>
		</div>
		{{template "base/modal_actions_confirm" .}}
	</div>
{{end}}
