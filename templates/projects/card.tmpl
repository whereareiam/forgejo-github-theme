{{/* GitHub-style project card: the repository and number above the title with the card menu beside them, assignees in
	the corner, then labels and compact details. Forgejo's repo/issue/card stays untouched for the pinned issues it also
	renders. */}}
{{$canWrite := and $.Page.CanWriteProjects (or (not $.Page.Repository) (not $.Page.Repository.IsArchived))}}
{{with .Issue}}
	{{if eq $.Page.Project.CardType 1}}{{/* Images and Text*/}}
		{{$attachments := index $.Page.issuesAttachmentMap .ID}}
		{{if $attachments}}
		<div class="card-attachment-images">
			{{range $attachments}}
				<img src="{{.DownloadURL}}" alt="{{.Name}}" loading="lazy"/>
			{{end}}
		</div>
		{{end}}
	{{end}}
	<div class="content github-project-card">
		<div class="github-project-card-meta">
			<span class="issue-card-icon">{{template "shared/issueicon" .}}</span>
			<span class="github-project-card-ref">{{.Repo.Name}} #{{.Index}}</span>
			{{template "components/common/dropdown/dropdown" dict "Kind" "actions" "Icon" "octicon-kebab-horizontal" "IconOnly" true "Small" true "Quiet" true "Label" (ctx.Locale.Tr "profile.actions.tooltip") "Items" "projects/card_menu" "Data" (dict "Context" $.Page.Context "Link" .Link "Columns" $.Page.Columns "CanWrite" $canWrite)}}
			{{if .Assignees}}
				<span class="github-project-card-assignees">
					{{range .Assignees}}
						<a target="_blank" href="{{.HomeLink}}" data-tooltip-content="{{ctx.Locale.Tr "repo.projects.column.assigned_to"}} {{.Name}}">{{ctx.AvatarUtils.Avatar . 20}}</a>
					{{end}}
				</span>
			{{end}}
		</div>
		<a class="issue-card-title github-project-card-title" href="{{.Link}}">{{RenderRefIssueTitle $.Context .Title}}</a>
		{{if .Labels}}
			<div class="labels-list">
				{{range .Labels}}
					<a target="_blank" href="{{$.Issue.Repo.Link}}/issues?labels={{.ID}}">{{template "components/repository/label/label" .}}</a>
				{{end}}
			</div>
		{{end}}
		{{$tasks := .GetTasks}}
		{{$linkedPRs := and $.Page.LinkedPRs (index $.Page.LinkedPRs .ID)}}
		{{if or .MilestoneID $linkedPRs (gt $tasks 0)}}
			<div class="github-project-card-details">
				{{if .MilestoneID}}
					<a class="muted" href="{{.Repo.Link}}/milestone/{{.MilestoneID}}">{{svg "octicon-milestone" 12}}<span>{{.Milestone.Name}}</span></a>
				{{end}}
				{{range $linkedPRs}}
					<a class="muted" href="{{.Repo.Link}}/pulls/{{.Index}}"><span class="text {{if .PullRequest.HasMerged}}purple{{else if .IsClosed}}red{{else}}green{{end}}">{{svg "octicon-git-pull-request" 12}}</span><span>{{.Title}} #{{.Index}}</span></a>
				{{end}}
				{{if gt $tasks 0}}
					<span>{{svg "octicon-checklist" 12}}<span>{{.GetTasksDone}} / {{$tasks}}</span></span>
				{{end}}
			</div>
		{{end}}
	</div>
{{end}}
