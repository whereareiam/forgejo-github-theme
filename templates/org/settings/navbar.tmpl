{{/* GitHub's organization settings nav: an icon per page in groups. Forgejo has strings only for Integrations, so
	the other groups are set apart by a separator instead of an English name. */}}
<div class="flex-container-nav">
	<div class="ui fluid vertical menu theme-nav-list">
		<a class="{{if .PageIsSettingsOptions}}active {{end}}item" href="{{.OrgLink}}/settings">
			{{svg "octicon-gear" 16}}{{ctx.Locale.Tr "org.settings.options"}}
		</a>
		<div class="theme-settings-separator" role="separator"></div>
		<a class="{{if .PageIsOrgSettingsRepos}}active {{end}}item" href="{{.OrgLink}}/settings/repos">
			{{svg "octicon-repo" 16}}{{ctx.Locale.Tr "settings.repos"}}
		</a>
		<a class="{{if .PageIsSettingsBlockedUsers}}active {{end}}item" href="{{.OrgLink}}/settings/blocked_users">
			{{svg "octicon-blocked" 16}}{{ctx.Locale.Tr "settings.blocked_users"}}
		</a>
		<div class="theme-settings-separator" role="separator"></div>
		<a class="{{if .PageIsOrgSettingsLabels}}active {{end}}item" href="{{.OrgLink}}/settings/labels">
			{{svg "octicon-tag" 16}}{{ctx.Locale.Tr "repo.labels"}}
		</a>
		{{if .EnableActions}}
		<details class="item toggleable-item" {{if or .PageIsSharedSettingsRunners .PageIsSharedSettingsSecrets .PageIsSharedSettingsVariables}}open{{end}}>
			<summary>{{svg "octicon-play" 16}}{{ctx.Locale.Tr "actions.actions"}}</summary>
			<div class="menu">
				<a class="{{if .PageIsSharedSettingsRunners}}active {{end}}item" href="{{.OrgLink}}/settings/actions/runners">
					{{ctx.Locale.Tr "actions.runners"}}
				</a>
				<a class="{{if .PageIsSharedSettingsSecrets}}active {{end}}item" href="{{.OrgLink}}/settings/actions/secrets">
					{{ctx.Locale.Tr "secrets.secrets"}}
				</a>
				<a class="{{if .PageIsSharedSettingsVariables}}active {{end}}item" href="{{.OrgLink}}/settings/actions/variables">
					{{ctx.Locale.Tr "actions.variables"}}
				</a>
			</div>
		</details>
		{{end}}
		{{if not DisableWebhooks}}
		<a class="{{if .PageIsSettingsHooks}}active {{end}}item" href="{{.OrgLink}}/settings/hooks">
			{{svg "octicon-webhook" 16}}{{ctx.Locale.Tr "repo.settings.hooks"}}
		</a>
		{{end}}
		{{if .EnablePackages}}
		<a class="{{if .PageIsSettingsPackages}}active {{end}}item" href="{{.OrgLink}}/settings/packages">
			{{svg "octicon-package" 16}}{{ctx.Locale.Tr "packages.title"}}
		</a>
		{{end}}
		{{if .EnableQuota}}
			<a class="{{if .PageIsSettingsStorageOverview}}active {{end}}item" href="{{.OrgLink}}/settings/storage_overview">
				{{svg "octicon-database" 16}}{{ctx.Locale.Tr "settings.storage_overview"}}
			</a>
		{{end}}
		{{if .EnableOAuth2}}
		<div class="theme-settings-group">{{ctx.Locale.Tr "admin.integrations"}}</div>
		<a class="{{if .PageIsSettingsApplications}}active {{end}}item" href="{{.OrgLink}}/settings/applications">
			{{svg "octicon-apps" 16}}{{ctx.Locale.Tr "settings.applications"}}
		</a>
		{{end}}
		<div class="theme-settings-separator" role="separator"></div>
		<a class="{{if .PageIsSettingsDelete}}active {{end}}item" href="{{.OrgLink}}/settings/delete">
			{{svg "octicon-trash" 16}}{{ctx.Locale.Tr "org.settings.delete"}}
		</a>
	</div>
</div>
