{{/* GitHub lists the search qualifiers by name when the field gets focus; these are the ones Forgejo's issue search
     understands (the entries of Forgejo's shared/search/issue/syntax dialog), with its hint as the tooltip.
     search.js inserts data-insert at the caret and matches typing against the name or the qualifier. */}}
<div class="theme-search-syntax" role="listbox" aria-label="{{ctx.Locale.Tr "search.syntax"}}" hidden>
	<button type="button" class="theme-search-syntax-item" role="option" data-insert="is:open " title="is:open">{{svg "octicon-issue-opened" 16}}<span>{{ctx.Locale.Tr "repo.issues.open_title"}}</span></button>
	<button type="button" class="theme-search-syntax-item" role="option" data-insert="is:closed " title="is:closed">{{svg "octicon-issue-closed" 16}}<span>{{ctx.Locale.Tr "repo.issues.closed_title"}}</span></button>
	<button type="button" class="theme-search-syntax-item" role="option" data-insert="is:all " title="is:all">{{svg "octicon-tasklist" 16}}<span>{{ctx.Locale.Tr "repo.issues.all_title"}}</span></button>
	<button type="button" class="theme-search-syntax-item" role="option" data-insert="author:" title="{{ctx.Locale.Tr "repo.issues.filter_poster.hint"}}">{{svg "octicon-person" 16}}<span>{{ctx.Locale.Tr "repo.issues.filter_poster"}}</span></button>
	<button type="button" class="theme-search-syntax-item" role="option" data-insert="assignee:" title="{{ctx.Locale.Tr "repo.issues.filter_assignee.hint"}}">{{svg "octicon-people" 16}}<span>{{ctx.Locale.Tr "repo.issues.filter_assignee"}}</span></button>
	<button type="button" class="theme-search-syntax-item" role="option" data-insert="review:" title="{{ctx.Locale.Tr "repo.issues.filter_reviewers.hint"}}">{{svg "octicon-eye" 16}}<span>{{ctx.Locale.Tr "repo.issues.review.reviewers"}}</span></button>
	<button type="button" class="theme-search-syntax-item" role="option" data-insert="mentions:" title="{{ctx.Locale.Tr "repo.issues.filter_mention.hint"}}">{{svg "octicon-mention" 16}}<span>{{ctx.Locale.Tr "repo.issues.filter_mention.hint"}}</span></button>
	<button type="button" class="theme-search-syntax-item" role="option" data-insert="sort:" title="{{ctx.Locale.Tr "repo.issues.filter_sort.hint_with_placeholder" "created|comments|updated|deadline"}}">{{svg "octicon-sort-desc" 16}}<span>{{ctx.Locale.Tr "repo.issues.filter_sort"}}</span></button>
	<button type="button" class="theme-search-syntax-item" role="option" data-insert="modified:" title="{{ctx.Locale.Tr "repo.issues.filter_modified.hint"}}">{{svg "octicon-calendar" 16}}<span>{{ctx.Locale.Tr "repo.issues.filter_modified.hint"}}</span></button>
	<button type="button" class="theme-search-syntax-item" role="option" data-insert="&quot;" title="{{ctx.Locale.Tr "search.match_inside_quotes"}}">{{svg "octicon-quote" 16}}<span>{{ctx.Locale.Tr "search.exact"}}</span></button>
	<a class="theme-search-syntax-docs" href="{{AppDocsURL "user/search/issue-search/"}}" target="_blank" rel="noopener noreferrer">{{svg "octicon-question" 16}}{{ctx.Locale.Tr "search.syntax"}}</a>
</div>
