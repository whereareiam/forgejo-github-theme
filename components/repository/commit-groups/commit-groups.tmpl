{{/* Commits grouped by the day they were committed, newest first as Forgejo lists them, each day a box of shared
commit rows. Called with the page context. */}}
{{$previousDate := ""}}
{{range .Commits}}
  {{$time := .Committer.When}}{{if not $time}}{{$time = .Author.When}}{{end}}
  {{$date := $time.Format "2006-01-02"}}
  {{if ne $date $previousDate}}
    {{if ne $previousDate ""}}</ul></article>{{end}}
    {{$previousDate = $date}}
    <article class="theme-commit-group">
      <h3>{{svg "octicon-git-commit" 16}}{{DateUtils.AbsoluteLong $time}}</h3>
      <ul class="gitea-github-theme-templates-commits-list">
  {{end}}
    {{template "repo/commit_list_item" dict "Commit" . "Page" $}}
{{end}}
{{if ne $previousDate ""}}</ul></article>{{end}}
